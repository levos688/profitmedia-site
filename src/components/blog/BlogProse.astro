---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`blog-prose ${className}`}>
  <slot />
</div>

<style>
  .blog-prose {
    color: #374151;
    font-size: 1.25rem;
    line-height: 1.75;
  }

  .blog-prose :global(p) {
    margin: 0 0 1.25rem;
  }

  .blog-prose :global(h2) {
    margin: 2.5rem 0 1rem;
    font-size: 1.75rem;
    line-height: 1.3;
    font-weight: 900;
    color: #29102c;
  }

  .blog-prose :global(h3) {
    margin: 1.75rem 0 0.75rem;
    font-size: 1.4375rem;
    line-height: 1.35;
    font-weight: 800;
    color: #29102c;
  }

  .blog-prose :global(ul) {
    margin: 0 0 1.25rem;
    padding-inline-end: 1.5rem;
    list-style: disc;
    display: grid;
    gap: 0.5rem;
  }

  .blog-prose :global(li) {
    line-height: 1.7;
  }

  .blog-prose :global(strong) {
    color: #651561;
    font-weight: 800;
  }

  .blog-prose :global(a) {
    color: #651561;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: rgba(101, 21, 97, 0.35);
  }

  .blog-prose :global(a:hover) {
    text-decoration-color: currentColor;
  }

  .blog-prose :global(blockquote) {
    margin: 1.25rem 0;
    padding: 1.1rem 1.4rem;
    border-inline-start: 4px solid #fcc000;
    border-radius: 4px;
    background: rgba(101, 21, 97, 0.04);
    color: #29102c;
    font-size: 1.25rem;
    font-weight: 700;
    font-style: normal;
  }

  .blog-prose :global(blockquote p) {
    margin: 0;
  }

  .blog-prose :global(blockquote cite) {
    display: block;
    margin-top: 0.6rem;
    color: #6b7280;
    font-size: 0.875rem;
    font-weight: 600;
    font-style: normal;
  }

  .blog-prose :global(.blog-callout) {
    margin: 1.5rem 0;
    padding: 1.25rem 1.5rem;
    border: 1px solid rgba(101, 21, 97, 0.12);
    border-radius: 4px;
    background: #faf8fc;
  }

  .blog-prose :global(.blog-callout p:last-child) {
    margin-bottom: 0;
  }

  .blog-prose :global(table) {
    display: block;
    width: 100%;
    max-width: 100%;
    margin: 1.5rem 0 1.75rem;
    border-collapse: collapse;
    font-size: 1.0625rem;
    line-height: 1.55;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .blog-prose :global(th),
  .blog-prose :global(td) {
    padding: 0.75rem 0.85rem;
    border: 1px solid rgba(101, 21, 97, 0.14);
    text-align: start;
    vertical-align: top;
  }

  .blog-prose :global(th) {
    background: rgba(101, 21, 97, 0.06);
    color: #29102c;
    font-weight: 800;
  }

  .blog-prose :global(td) {
    background: #fff;
  }

  .blog-prose :global(tr:nth-child(even) td) {
    background: #faf8fc;
  }

  .blog-prose :global(ol) {
    margin: 0 0 1.25rem;
    padding-inline-end: 1.5rem;
    list-style: decimal;
    display: grid;
    gap: 0.5rem;
  }

  .blog-prose :global(.blog-cpl-compare) {
    margin: 1.6rem 0 1.85rem;
    padding: 1.15rem 1rem 1.05rem;
    border: 1px solid rgba(101, 21, 97, 0.12);
    border-radius: 4px;
    background:
      radial-gradient(ellipse at 100% 0%, rgba(252, 192, 0, 0.12), transparent 42%),
      #faf8fc;
  }

  .blog-prose :global(.blog-cpl-compare p),
  .blog-prose :global(.blog-cpl-compare figcaption) {
    margin: 0;
  }

  .blog-prose :global(.blog-cpl-compare__legend) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem 1.25rem;
    margin-bottom: 0.95rem;
    color: #4b5563;
    font-size: 0.9375rem;
    font-weight: 700;
  }

  .blog-prose :global(.blog-cpl-swatch) {
    display: inline-block;
    width: 0.7rem;
    height: 0.7rem;
    margin-inline-end: 0.35rem;
    border-radius: 2px;
    vertical-align: -0.05rem;
  }

  .blog-prose :global(.blog-cpl-swatch--lead) {
    background: #e4d4e8;
  }

  .blog-prose :global(.blog-cpl-swatch--paid) {
    background: #fcc000;
  }

  .blog-prose :global(.blog-cpl-compare__grid) {
    display: grid;
    gap: 0.85rem;
  }

  .blog-prose :global(.blog-cpl-compare__vs) {
    display: none;
    margin: 0;
    color: #651561;
    font-size: 0.875rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .blog-prose :global(.blog-cpl-card) {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 1rem 1rem 0.95rem;
    border: 1px solid rgba(101, 21, 97, 0.14);
    border-radius: 4px;
    background: #fff;
  }

  .blog-prose :global(.blog-cpl-card--win) {
    border-color: #651561;
    box-shadow: inset 0 3px 0 #fcc000;
  }

  .blog-prose :global(.blog-cpl-card__kicker) {
    color: #6b7280;
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  .blog-prose :global(.blog-cpl-card--win .blog-cpl-card__kicker) {
    color: #651561;
  }

  .blog-prose :global(.blog-cpl-card__name) {
    margin-top: 0.2rem;
    color: #29102c;
    font-size: 1.25rem;
    font-weight: 900;
    line-height: 1.25;
  }

  .blog-prose :global(.blog-cpl-card svg) {
    display: block;
    width: 100%;
    margin-top: 0.85rem;
    padding: 0.55rem;
    border-radius: 3px;
    background: #f7f2f8;
    height: auto;
  }

  .blog-prose :global(.blog-cpl-card__flow) {
    margin-top: 0.7rem;
    color: #29102c;
    font-size: 1rem;
    font-weight: 800;
    line-height: 1.45;
  }

  .blog-prose :global(.blog-cpl-card dl) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.7rem 0.75rem;
    margin: auto 0 0;
    padding-top: 0.95rem;
  }

  .blog-prose :global(.blog-cpl-card dl > div) {
    min-width: 0;
  }

  .blog-prose :global(.blog-cpl-card dt) {
    color: #6b7280;
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .blog-prose :global(.blog-cpl-card dd) {
    margin: 0;
    color: #29102c;
    font-size: 1.125rem;
    font-weight: 900;
    line-height: 1.25;
    font-variant-numeric: tabular-nums;
  }

  .blog-prose :global(.blog-cpl-card .is-warn dd) {
    color: #651561;
  }

  .blog-prose :global(.blog-cpl-card--win .is-win) {
    grid-column: 1 / -1;
    padding: 0.55rem 0.65rem;
    border-radius: 3px;
    background: rgba(252, 192, 0, 0.18);
  }

  .blog-prose :global(.blog-cpl-card--win .is-win dd) {
    font-size: 1.3125rem;
  }

  .blog-prose :global(.blog-cpl-roas) {
    display: grid;
    gap: 0.28rem;
    margin-top: 0.85rem;
  }

  .blog-prose :global(.blog-cpl-roas__track) {
    height: 0.45rem;
    overflow: hidden;
    border-radius: 99px;
    background: rgba(101, 21, 97, 0.1);
  }

  .blog-prose :global(.blog-cpl-roas__track span) {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: #cbb3ce;
  }

  .blog-prose :global(.blog-cpl-card--win .blog-cpl-roas__track span) {
    background: #651561;
  }

  .blog-prose :global(.blog-cpl-roas__label) {
    color: #4b5563;
    font-size: 0.875rem;
    font-weight: 700;
  }

  .blog-prose :global(.blog-cpl-card__foot) {
    margin-top: 0.85rem;
    padding-top: 0.7rem;
    border-top: 1px solid rgba(101, 21, 97, 0.1);
    color: #4b5563;
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.45;
  }

  .blog-prose :global(.blog-cpl-card--win .blog-cpl-card__foot) {
    color: #651561;
  }

  .blog-prose :global(.blog-cpl-compare > figcaption) {
    margin-top: 0.9rem;
    color: #6b7280;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.5;
  }

  @media (min-width: 720px) {
    .blog-prose :global(.blog-cpl-compare) {
      padding: 1.25rem 1.15rem 1.1rem;
    }

    .blog-prose :global(.blog-cpl-compare__grid) {
      grid-template-columns: 1fr auto 1fr;
      align-items: stretch;
      gap: 0.7rem;
    }

    .blog-prose :global(.blog-cpl-compare__vs) {
      display: flex;
      align-items: center;
      justify-content: center;
      padding-inline: 0.15rem;
    }
  }
</style>
