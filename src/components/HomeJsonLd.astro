---
import {
  targetAudience as defaultTargetAudience,
  processSteps as defaultProcessSteps,
  hero as defaultHero,
  homeSeo as defaultSeo,
  faqs as defaultFaqs,
  services as defaultServices,
} from '../data/site';
import type { Locale } from '../i18n/config';
import type { HomeContent } from '../i18n/he/home';

interface Props {
  locale?: Locale;
  content?: Pick<HomeContent, 'targetAudience' | 'processSteps' | 'hero' | 'seo' | 'faqs' | 'services'>;
}

const { locale = 'he' } = Astro.props;
const content = Astro.props.content ?? {
  targetAudience: defaultTargetAudience,
  processSteps: defaultProcessSteps,
  hero: defaultHero,
  seo: defaultSeo,
  faqs: defaultFaqs,
  services: defaultServices,
};
const { targetAudience, processSteps, hero, seo: homeSeo, faqs, services } = content;
const inLanguage = locale === 'he' ? 'he-IL' : 'ru';
const pageId = `${homeSeo.canonical}#webpage`;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': 'https://profitmedia.co.il/#organization',
  name: 'Profit Media',
  alternateName: 'פרופיט מדיה',
  url: 'https://profitmedia.co.il/',
  logo: 'https://profitmedia.co.il/icons/site-icon.png',
  image: 'https://profitmedia.co.il/icons/site-icon.png',
  description: homeSeo.description,
  inLanguage,
  areaServed: {
    '@type': locale === 'he' ? 'Country' : 'AdministrativeArea',
    name: locale === 'he' ? 'Israel' : 'Worldwide',
  },
  serviceType: services.map((service) => service.title),
  knowsAbout: [
    'Facebook Ads',
    'Google Ads',
    'Instagram Ads',
    'Landing pages',
    'Conversion rate optimization',
    'Deal CRM',
    'Offline conversions / lead quality feedback (Meta, Google, TikTok)',
    'A/B testing',
    'High-ticket sales',
  ],
  audience: {
    '@type': 'BusinessAudience',
    audienceType: targetAudience.subtitle,
  },
  availableLanguage: ['he', 'ru'],
};

const audienceListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': `${homeSeo.canonical}#for-whom`,
  name: targetAudience.title,
  description: targetAudience.subtitle,
  itemListElement: targetAudience.items.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.title,
    description: `${item.situation} ${item.outcome}`,
  })),
};

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  '@id': `${homeSeo.canonical}#how-it-works`,
  name: processSteps.title,
  description: processSteps.subtitle,
  step: processSteps.steps.map((step, index) => ({
    '@type': 'HowToStep',
    position: index + 1,
    name: step.title,
    text: step.description,
  })),
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': 'https://profitmedia.co.il/#website',
  url: 'https://profitmedia.co.il/',
  name: 'Profit Media',
  description: homeSeo.description,
  inLanguage,
  publisher: {
    '@id': 'https://profitmedia.co.il/#organization',
  },
};

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': pageId,
  url: homeSeo.canonical,
  name: homeSeo.title,
  description: homeSeo.description,
  inLanguage,
  isPartOf: {
    '@id': 'https://profitmedia.co.il/#website',
  },
  about: {
    '@id': 'https://profitmedia.co.il/#organization',
  },
  primaryImageOfPage: {
    '@type': 'ImageObject',
    url: 'https://profitmedia.co.il/images/hero/photo-min.svg',
  },
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: hero.title,
  description: hero.subtitle,
  provider: {
    '@id': 'https://profitmedia.co.il/#organization',
  },
  areaServed: {
    '@type': locale === 'he' ? 'Country' : 'AdministrativeArea',
    name: locale === 'he' ? 'Israel' : 'Worldwide',
  },
  serviceType: services.map((service) => service.title),
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${homeSeo.canonical}#faq`,
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    organizationSchema,
    websiteSchema,
    webPageSchema,
    serviceSchema,
    audienceListSchema,
    howToSchema,
    faqSchema,
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
