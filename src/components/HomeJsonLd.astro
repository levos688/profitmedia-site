---
import {
  targetAudience as defaultTargetAudience,
  processSteps as defaultProcessSteps,
  hero as defaultHero,
  homeSeo as defaultSeo,
  faqs as defaultFaqs,
  services as defaultServices,
} from '../data/site';
import type { Locale } from '../i18n/config';
import type { HomeContent } from '../i18n/he/home';
import {
  buildFaqPageSchema,
  buildHowToSchema,
  buildItemListSchema,
  buildOrganizationSchema,
  buildSchemaGraph,
  buildServiceSchema,
  buildWebPageSchema,
  buildWebsiteSchema,
} from '../lib/schema';

interface Props {
  locale?: Locale;
  content?: Pick<HomeContent, 'targetAudience' | 'processSteps' | 'hero' | 'seo' | 'faqs' | 'services'>;
}

const { locale = 'he' } = Astro.props;
const content = Astro.props.content ?? {
  targetAudience: defaultTargetAudience,
  processSteps: defaultProcessSteps,
  hero: defaultHero,
  seo: defaultSeo,
  faqs: defaultFaqs,
  services: defaultServices,
};
const { targetAudience, processSteps, hero, seo: homeSeo, faqs, services } = content;
const serviceTypes = services.map((service) => service.title);
const heroTitle = hero.title.replace(/\n+/g, ' ');
const schemaGraph = buildSchemaGraph([
  buildOrganizationSchema({
    locale,
    description: homeSeo.description,
    serviceTypes,
    audience: targetAudience.subtitle,
  }),
  buildWebsiteSchema({ locale, description: homeSeo.description }),
  buildWebPageSchema({
    locale,
    canonical: homeSeo.canonical,
    name: heroTitle,
    description: hero.subtitle,
    image: 'https://profitmedia.co.il/images/hero/photo-min.svg',
  }),
  buildServiceSchema({
    locale,
    name: heroTitle,
    description: hero.subtitle,
    serviceTypes,
  }),
  buildItemListSchema({
    locale,
    canonical: homeSeo.canonical,
    name: targetAudience.title,
    description: targetAudience.subtitle,
    items: targetAudience.items.map((item) => ({
      title: item.title,
      description: `${item.situation} ${item.outcome}`,
    })),
  }),
  buildHowToSchema({
    locale,
    canonical: homeSeo.canonical,
    name: processSteps.title,
    description: processSteps.subtitle,
    steps: processSteps.steps,
  }),
  buildFaqPageSchema({ locale, canonical: homeSeo.canonical, items: faqs }),
]);
---

<script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
