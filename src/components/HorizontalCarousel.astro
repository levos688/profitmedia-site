---
/**
 * Working gallery recipe: docs/carousel-gallery.md
 * transform + clone loop, one card per step — do not switch back to scrollLeft on RTL.
 */
interface Props {
  ariaLabel: string;
  gap?: 'normal' | 'wide';
  shuffle?: boolean;
  /** Circular one-card steps. Default true. */
  loop?: boolean;
  /** Fade keeps every card whole; slide is the default for visual galleries. */
  motion?: 'slide' | 'fade';
  nextLabel?: string;
  previousLabel?: string;
}

const {
  ariaLabel,
  gap = 'normal',
  shuffle = false,
  loop = true,
  motion = 'slide',
  nextLabel = 'גלול קדימה',
  previousLabel = 'גלול אחורה',
} = Astro.props;
const uid = `carousel-${Math.random().toString(36).slice(2, 9)}`;
---

<div
  class:list={['carousel-outer', gap === 'wide' && 'carousel-outer--wide']}
  role="region"
  aria-label={ariaLabel}
  data-carousel-root={uid}
>
  <button
    type="button"
    class="carousel-arrow carousel-arrow--prev"
    aria-label={previousLabel}
    data-carousel-prev={uid}
  >
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path
        d="M15 6l-6 6 6 6"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </button>

  <div class="carousel-viewport" data-carousel-viewport={uid}>
    <div class="carousel-strip" data-carousel-strip={uid} dir="ltr">
      <slot />
    </div>
  </div>

  <button
    type="button"
    class="carousel-arrow carousel-arrow--next"
    aria-label={nextLabel}
    data-carousel-next={uid}
  >
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path
        d="M9 6l6 6-6 6"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </button>
</div>

<script define:vars={{ uid, shuffle, loop, motion }}>
  (() => {
    const root = document.querySelector(`[data-carousel-root="${uid}"]`);
    const viewport = document.querySelector(`[data-carousel-viewport="${uid}"]`);
    const strip = document.querySelector(`[data-carousel-strip="${uid}"]`);
    const nextBtn = document.querySelector(`[data-carousel-next="${uid}"]`);
    const prevBtn = document.querySelector(`[data-carousel-prev="${uid}"]`);
    if (!root || !viewport || !strip || !nextBtn || !prevBtn) return;

    const getRealItems = () =>
      [...strip.querySelectorAll(':scope > .carousel-item:not([data-carousel-clone])')];
    const getAllItems = () => [...strip.querySelectorAll(':scope > .carousel-item')];

    if (shuffle) {
      const items = getRealItems();
      for (let i = items.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [items[i], items[j]] = [items[j], items[i]];
      }
      items.forEach((item) => strip.appendChild(item));
    }

    let realCount = 0;
    let loopOn = false;
    let index = 0;
    let busy = false;
    let currentX = 0;

    const reduceMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isMobile = () => window.matchMedia('(max-width: 767px)').matches;

    const setupLoop = () => {
      const items = getRealItems();
      realCount = items.length;
      if (!loop || realCount < 2) {
        loopOn = false;
        index = 0;
        return;
      }

      const before = document.createDocumentFragment();
      const after = document.createDocumentFragment();

      items.forEach((item) => {
        const cloneBefore = item.cloneNode(true);
        const cloneAfter = item.cloneNode(true);
        [cloneBefore, cloneAfter].forEach((clone) => {
          clone.setAttribute('data-carousel-clone', '');
          clone.setAttribute('aria-hidden', 'true');
          clone.querySelectorAll('button, a, input, select, textarea').forEach((el) => {
            el.setAttribute('tabindex', '-1');
            el.setAttribute('disabled', '');
            el.style.pointerEvents = 'none';
          });
        });
        before.appendChild(cloneBefore);
        after.appendChild(cloneAfter);
      });

      strip.insertBefore(before, strip.firstChild);
      strip.appendChild(after);
      loopOn = true;
      // Start on first REAL item (middle section).
      index = realCount;
    };

    const maxOffset = () => Math.max(0, strip.scrollWidth - viewport.clientWidth);

    const offsetForIndex = (i) => {
      const items = getAllItems();
      const item = items[i];
      if (!item) return 0;
      return Math.min(Math.max(0, item.offsetLeft), maxOffset());
    };

    const updatePeek = () => {
      const items = getAllItems();
      if (!isMobile()) {
        for (let i = 0; i < items.length; i++) {
          items[i].classList.remove('is-active', 'is-peek');
        }
        return;
      }
      for (let i = 0; i < items.length; i++) {
        items[i].classList.toggle('is-active', i === index);
        items[i].classList.toggle('is-peek', i !== index);
      }
    };

    const updateArrows = () => {
      if (loopOn) {
        prevBtn.disabled = false;
        nextBtn.disabled = false;
        return;
      }
      const items = getAllItems();
      prevBtn.disabled = index <= 0;
      nextBtn.disabled = index >= items.length - 1 || maxOffset() <= 1;
    };

    const setX = (x, animate) => {
      if (animate && !reduceMotion() && motion === 'fade') {
        strip.style.transition = 'opacity 0.12s ease';
        strip.style.opacity = '0';
        window.setTimeout(() => {
          strip.style.transition = 'none';
          strip.style.transform = `translate3d(${x}px, 0, 0)`;
          requestAnimationFrame(() => {
            strip.style.transition = 'opacity 0.18s ease';
            strip.style.opacity = '1';
          });
        }, 120);
      } else if (animate && !reduceMotion()) {
        strip.style.transition = 'transform 0.4s ease';
        strip.style.transform = `translate3d(${x}px, 0, 0)`;
      } else {
        strip.style.transition = 'none';
        strip.style.opacity = '1';
        strip.style.transform = `translate3d(${x}px, 0, 0)`;
      }
      currentX = x;
    };

    /** After a step into the clone zone, jump to the matching real item with no animation. */
    const normalizeIfNeeded = () => {
      if (!loopOn || realCount < 2) return;
      if (index < realCount) {
        index += realCount;
        setX(-offsetForIndex(index), false);
      } else if (index >= realCount * 2) {
        index -= realCount;
        setX(-offsetForIndex(index), false);
      }
    };

    const goTo = (nextIndex, animate) => {
      const items = getAllItems();
      if (!items.length || busy) return;
      if (nextIndex < 0 || nextIndex >= items.length) return;

      // Guard: only adjacent steps (one card).
      if (Math.abs(nextIndex - index) !== 1 && animate) return;

      busy = true;
      index = nextIndex;
      setX(-offsetForIndex(index), animate);
      updatePeek();
      updateArrows();

      const done = () => {
        normalizeIfNeeded();
        updatePeek();
        updateArrows();
        busy = false;
      };

      if (!animate || reduceMotion()) {
        done();
        return;
      }
      window.setTimeout(done, 420);
      // Failsafe: iOS pauses timeouts while a native image sheet is open.
      window.setTimeout(() => {
        busy = false;
      }, 800);
    };

    const step = (delta) => {
      goTo(index + delta, true);
    };

    nextBtn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      if (busy) return;
      step(1);
    });

    prevBtn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      if (busy) return;
      step(-1);
    });

    let touchX = 0;
    let touchY = 0;
    let ignoreTouchUntil = 0;
    viewport.addEventListener(
      'touchstart',
      (e) => {
        const t = e.changedTouches[0];
        touchX = t?.clientX ?? 0;
        touchY = t?.clientY ?? 0;
      },
      { passive: true }
    );
    viewport.addEventListener(
      'touchend',
      (e) => {
        if (busy) return;
        if (Date.now() < ignoreTouchUntil) return;
        // Opening the lightbox must not also count as a swipe (iOS then pauses
        // timers and `busy` stays true → gallery looks frozen).
        if (document.documentElement.classList.contains('lightbox-open')) return;
        const from = e.target && e.target.closest ? e.target : e.target && e.target.parentElement;
        if (from && from.closest && from.closest('[data-lightbox-trigger]')) return;
        const t = e.changedTouches[0];
        if (!t) return;
        const dx = t.clientX - touchX;
        const dy = t.clientY - touchY;
        if (Math.abs(dx) < 40 || Math.abs(dx) < Math.abs(dy)) return;
        step(dx < 0 ? 1 : -1);
      },
      { passive: true }
    );

    window.addEventListener(
      'resize',
      () => {
        setX(-offsetForIndex(index), false);
        updatePeek();
        updateArrows();
      },
      { passive: true }
    );

    const boot = () => {
      setupLoop();
      setX(-offsetForIndex(index), false);
      updatePeek();
      updateArrows();
      root.setAttribute('data-carousel-ready', '');
      // Remeasure after images load.
      window.setTimeout(() => {
        setX(-offsetForIndex(index), false);
        updateArrows();
      }, 300);
    };

    const rebuildFromDom = () => {
      // Drop previous clones, keep real items as currently in strip.
      getAllItems()
        .filter((el) => el.hasAttribute('data-carousel-clone'))
        .forEach((el) => el.remove());
      busy = false;
      boot();
    };

    root.addEventListener('pm:carousel-reload', rebuildFromDom);

    const clearBusy = () => {
      busy = false;
      ignoreTouchUntil = Date.now() + 500;
    };
    window.addEventListener('pageshow', clearBusy);
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') clearBusy();
    });
    document.addEventListener('pm:lightbox', clearBusy);

    requestAnimationFrame(() => requestAnimationFrame(boot));
  })();
</script>

<style>
  .carousel-outer {
    position: relative;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.75rem;
    max-width: 100%;
    min-width: 0;
    direction: ltr; /* physical order [prev][content][next] on both locales */
  }

  .carousel-outer--wide {
    gap: 1rem;
  }

  .carousel-viewport {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    touch-action: pan-y;
  }

  .carousel-strip {
    display: flex;
    position: relative;
    direction: ltr;
    gap: 1.5rem;
    will-change: transform;
    padding-block: 0.25rem;
    transform: translate3d(0, 0, 0);
  }

  .carousel-outer--wide .carousel-strip {
    gap: 1.5rem;
  }

  .carousel-strip :global(.carousel-item) {
    flex: 0 0 auto;
  }

  /* Stop iOS from opening the native image viewer on gallery/logo taps. */
  .carousel-strip :global(img) {
    pointer-events: none;
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    user-select: none;
  }

  .carousel-arrow {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    min-width: 44px;
    min-height: 44px;
    border-radius: 50%;
    border: 2px solid #c60691;
    background: #fff;
    color: #651561;
    cursor: pointer;
    transition:
      background-color 0.2s,
      color 0.2s,
      opacity 0.2s;
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.08);
    z-index: 6;
    pointer-events: auto;
    -webkit-tap-highlight-color: transparent;
  }

  .carousel-arrow:hover:not(:disabled) {
    background: #651561;
    color: #fff;
    border-color: #651561;
  }

  .carousel-arrow:disabled {
    opacity: 0.35;
    cursor: default;
    pointer-events: none;
  }

  .carousel-arrow:focus-visible {
    outline: 2px solid #fcc000;
    outline-offset: 2px;
  }

  @media (max-width: 767px) {
    .carousel-outer {
      gap: 0;
    }

    .carousel-viewport {
      width: 100%;
      padding-inline: 2.75rem;
    }

    .carousel-strip {
      gap: 1rem;
    }

    .carousel-arrow {
      position: absolute;
      top: 38%;
      transform: translateY(-50%);
      width: 2.5rem;
      height: 2.5rem;
      background: rgb(255 255 255 / 0.96);
    }

    .carousel-arrow--prev {
      left: 0.35rem;
    }

    .carousel-arrow--next {
      right: 0.35rem;
    }

    .carousel-strip :global(.carousel-item) {
      opacity: 0.45;
      transition: opacity 0.35s ease;
    }

    .carousel-strip :global(.carousel-item.is-active),
    .carousel-strip :global(.carousel-item:only-child) {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel-strip {
      transition: none !important;
    }

    .carousel-arrow,
    .carousel-strip :global(.carousel-item) {
      transition: none;
    }
  }
</style>
