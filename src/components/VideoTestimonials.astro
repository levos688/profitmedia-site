---
import SectionTitle from './SectionTitle.astro';
import Reveal from './Reveal.astro';
import YoutubeFacade from './YoutubeFacade.astro';
import { videoTestimonials } from '../data/site';
---

<section id="video-testimonials" class="section-padding below-fold bg-white" aria-labelledby="video-testimonials-title">
  <div class="mx-auto max-w-6xl px-4 md:px-6">
    <Reveal>
      <SectionTitle title="עדויות וידאו" id="video-testimonials-title" class="mb-10 md:mb-14" />
    </Reveal>

    <Reveal delay={120}>
      <div class="video-testimonials__grid">
        {
          videoTestimonials.map((video) => (
            <figure class="video-card">
              <YoutubeFacade youtubeId={video.youtubeId} title={video.title} aspect="portrait" />
              <figcaption class="video-card__caption">{video.title}</figcaption>
            </figure>
          ))
        }
      </div>
    </Reveal>
  </div>
</section>

<style>
  .video-testimonials__grid {
    display: grid;
    gap: 2rem;
    width: 100%;
    max-width: 42rem;
    margin-inline: auto;
    justify-items: center;
  }

  @media (min-width: 768px) {
    .video-testimonials__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2.5rem;
      max-width: 36rem;
      justify-items: stretch;
    }
  }

  .video-card {
    width: min(100%, 280px);
    min-width: 0;
    margin: 0;
  }

  @media (min-width: 768px) {
    .video-card {
      width: 100%;
      max-width: 260px;
      margin-inline: auto;
    }
  }

  .video-card__caption {
    margin-top: 0.75rem;
    text-align: center;
    font-size: 0.875rem;
    font-weight: 500;
    color: #4b5563;
  }
</style>

<script>
  document.querySelectorAll('.youtube-facade__btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const button = btn as HTMLButtonElement;
      const id = button.dataset.youtubeId;
      const title = button.dataset.youtubeTitle || 'YouTube video';
      if (!id) return;

      const wrapper = button.parentElement;
      if (!wrapper) return;

      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&playsinline=1&rel=0`;
      iframe.title = title;
      iframe.setAttribute('allowfullscreen', '');
      iframe.loading = 'lazy';
      iframe.allow =
        'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';

      wrapper.innerHTML = '';
      wrapper.appendChild(iframe);
    });
  });
</script>
