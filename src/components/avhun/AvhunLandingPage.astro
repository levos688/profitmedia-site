---
import { avhun } from '../../data/avhun';
import { formLabels, formPlaceholders } from '../../data/site';

const labels = {
  name: formLabels.name,
  phone: formLabels.phone,
  vertical: formLabels.vertical,
};
const placeholders = {
  name: formPlaceholders.name,
  phone: formPlaceholders.phone,
  vertical: formPlaceholders.vertical,
};
---

<header class="avhun-top">
  <a href="/" class="avhun-logo" aria-label="Profit Media, דף הבית">
    <img src="/logo.svg" alt="Profit Media" width="160" height="56" />
  </a>
</header>

<main id="main-content">
  <section class="avhun-hero" aria-labelledby="avhun-title">
    <div class="avhun-hero__glow" aria-hidden="true"></div>
    <div class="avhun-hero__inner">
      <div class="avhun-hero__copy">
        <p class="avhun-eyebrow">{avhun.eyebrow}</p>
        <h1 id="avhun-title">{avhun.title}</h1>
        <p class="avhun-sub">{avhun.subtitle}</p>

        <div class="avhun-proof-row">
          <p class="avhun-chip"><strong>₪200K+</strong> במכירות שדווחו בחודש · לקוח מטבחים</p>
          <p class="avhun-trust">{avhun.trustLine}</p>
        </div>
      </div>

      <div class="avhun-card" id="form">
        <div class="avhun-card__badge" aria-hidden="true">חינם</div>
        <h2 class="avhun-card__title">{avhun.formTitle}</h2>
        <p class="avhun-card__note">{avhun.ctaNote}</p>

        <form id="avhun-form" class="avhun-form" novalidate autocomplete="off">
          <div class="avhun-field">
            <label for="avhun-name">{labels.name}</label>
            <input
              id="avhun-name"
              name="name"
              type="text"
              required
              autocomplete="name"
              placeholder={placeholders.name}
            />
            <p id="avhun-name-error" class="avhun-error" hidden role="alert"></p>
          </div>
          <div class="avhun-field">
            <label for="avhun-phone">{labels.phone}</label>
            <input
              id="avhun-phone"
              name="phone"
              type="tel"
              required
              inputmode="tel"
              autocomplete="tel"
              pattern="[0-9\\-+() ]{9,15}"
              placeholder={placeholders.phone}
            />
            <p id="avhun-phone-error" class="avhun-error" hidden role="alert"></p>
          </div>
          <div class="avhun-field">
            <label for="avhun-vertical">{labels.vertical}</label>
            <input
              id="avhun-vertical"
              name="vertical"
              type="text"
              required
              autocomplete="organization-title"
              placeholder={placeholders.vertical}
            />
            <p id="avhun-vertical-error" class="avhun-error" hidden role="alert"></p>
          </div>

          <label class="avhun-privacy">
            <input id="avhun-privacy" name="privacy" type="checkbox" required />
            <span>
              קראתי ואני מאשר/ת את
              <a href="/prat" target="_blank" rel="noopener">מדיניות הפרטיות</a>
              , ומסכים/ה לשמירת המידע לצורך טיפול בפנייתי (חובה)
            </span>
          </label>
          <p id="avhun-privacy-error" class="avhun-error" hidden role="alert"></p>

          <button type="submit" id="avhun-submit" class="btn-yellow avhun-submit">
            <span id="avhun-submit-label">{avhun.cta}</span>
          </button>
          <p id="avhun-status" class="avhun-status" hidden role="status"></p>
        </form>
      </div>
    </div>
  </section>

  <section class="avhun-stats" aria-label="מספרים מהשטח">
    <div class="avhun-wrap avhun-stats__grid">
      {
        avhun.stats.map((stat) => (
          <div class="avhun-stat">
            <p class="avhun-stat__value">{stat.value}</p>
            <p class="avhun-stat__label">{stat.label}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="avhun-clients" aria-labelledby="avhun-clients-title">
    <div class="avhun-wrap">
      <h2 id="avhun-clients-title" class="avhun-clients__title">{avhun.clientsTitle}</h2>
      <ul class="avhun-clients__row">
        {
          avhun.clients.map((client) => (
            <li>
              <img src={client.src} alt={client.alt} width="120" height="48" loading="lazy" />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="avhun-section" aria-labelledby="avhun-includes-title">
    <div class="avhun-wrap">
      <h2 id="avhun-includes-title">{avhun.includesTitle}</h2>
      <ul class="avhun-tiles">
        {
          avhun.includes.map((item) => (
            <li class="avhun-tile">
              <img class="avhun-tile__icon" src={item.icon} alt="" width="72" height="72" loading="lazy" />
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="avhun-section avhun-section--soft" aria-labelledby="avhun-steps-title">
    <div class="avhun-wrap">
      <h2 id="avhun-steps-title">{avhun.stepsTitle}</h2>
      <ol class="avhun-steps">
        {
          avhun.steps.map((step) => (
            <li class="avhun-step">
              <span class="avhun-step__n" aria-hidden="true">
                {step.n}
              </span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="avhun-section" aria-labelledby="avhun-offer-title">
    <div class="avhun-wrap">
      <h2 id="avhun-offer-title">{avhun.offerTitle}</h2>
      <p class="avhun-section__sub">{avhun.offerSub}</p>
      <ul class="avhun-offer">
        {
          avhun.offerItems.map((item) => (
            <li class="avhun-offer__item">
              <img src={item.icon} alt="" width="88" height="88" loading="lazy" />
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="avhun-section avhun-section--soft" aria-labelledby="avhun-proof-title">
    <div class="avhun-wrap">
      <h2 id="avhun-proof-title">{avhun.proofTitle}</h2>
      <div class="avhun-proof">
        <div class="avhun-proof__shots">
          {
            avhun.proofImages.map((img) => (
              <figure>
                <img src={img.src} alt={img.alt} width="560" height="360" loading="lazy" />
              </figure>
            ))
          }
        </div>
        <blockquote class="avhun-quote">
          <p>“{avhun.caseStudy.quote}”</p>
          <footer>
            <strong>{avhun.caseStudy.attribution}</strong>
            <span>{avhun.caseStudy.label}</span>
          </footer>
        </blockquote>
      </div>
      <div class="avhun-center">
        <a href="#form" class="btn-yellow avhun-inline-cta">{avhun.cta}</a>
      </div>
    </div>
  </section>

  <section class="avhun-section" aria-labelledby="avhun-faq-title">
    <div class="avhun-wrap avhun-wrap--narrow">
      <h2 id="avhun-faq-title">שאלות נפוצות</h2>
      <div class="avhun-faq">
        {
          avhun.faqs.map((item) => (
            <details class="avhun-faq__item">
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="avhun-bottom" aria-labelledby="avhun-bottom-title">
    <div class="avhun-wrap avhun-bottom__inner">
      <div>
        <h2 id="avhun-bottom-title">{avhun.bottomCtaTitle}</h2>
        <p>{avhun.bottomCtaSub}</p>
      </div>
      <a href="#form" class="btn-yellow avhun-inline-cta">{avhun.cta}</a>
    </div>
  </section>
</main>

<footer class="avhun-footer">
  <p>© {new Date().getFullYear()} Profit Media</p>
  <p>
    <a href="/prat">מדיניות פרטיות</a>
    <span aria-hidden="true"> · </span>
    <a href="/hatzara">הצהרת נגישות</a>
  </p>
</footer>

<script define:vars={{ formSource: avhun.formSource, thankYouPath: avhun.thankYouPath, ctaLabel: avhun.cta }}>
  const form = document.getElementById('avhun-form');
  const submitBtn = document.getElementById('avhun-submit');
  const submitLabel = document.getElementById('avhun-submit-label');
  const status = document.getElementById('avhun-status');

  const fields = {
    name: {
      input: document.getElementById('avhun-name'),
      error: document.getElementById('avhun-name-error'),
      message: 'נא למלא שם מלא',
    },
    phone: {
      input: document.getElementById('avhun-phone'),
      error: document.getElementById('avhun-phone-error'),
      message: 'נא למלא טלפון תקין',
    },
    vertical: {
      input: document.getElementById('avhun-vertical'),
      error: document.getElementById('avhun-vertical-error'),
      message: 'נא לציין את תחום העסק',
    },
    privacy: {
      input: document.getElementById('avhun-privacy'),
      error: document.getElementById('avhun-privacy-error'),
      message: 'יש לאשר את מדיניות הפרטיות',
    },
  };

  const setError = (field, show) => {
    if (!field.input || !field.error) return;
    field.input.setAttribute('aria-invalid', show ? 'true' : 'false');
    field.error.hidden = !show;
    field.error.textContent = show ? field.message : '';
  };

  const validate = () => {
    let ok = true;
    const nameOk = Boolean(fields.name.input?.value.trim());
    setError(fields.name, !nameOk);
    ok = ok && nameOk;

    const phoneVal = fields.phone.input?.value.trim() || '';
    const phoneOk = /^[0-9\-+() ]{9,15}$/.test(phoneVal);
    setError(fields.phone, !phoneOk);
    ok = ok && phoneOk;

    const verticalOk = Boolean(fields.vertical.input?.value.trim());
    setError(fields.vertical, !verticalOk);
    ok = ok && verticalOk;

    const privacyOk = Boolean(fields.privacy.input?.checked);
    setError(fields.privacy, !privacyOk);
    ok = ok && privacyOk;

    return ok;
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (status) {
      status.hidden = true;
      status.textContent = '';
    }
    if (!validate()) {
      form.querySelector('[aria-invalid="true"]')?.focus();
      return;
    }

    if (submitBtn) submitBtn.disabled = true;
    if (submitLabel) submitLabel.textContent = 'שולח…';

    const payload = {
      name: fields.name.input?.value.trim(),
      phone: fields.phone.input?.value.trim(),
      email: '',
      vertical: fields.vertical.input?.value.trim() || '',
      verticalLabel: fields.vertical.input?.value.trim() || '',
      pageUrl: window.location.href,
      source: formSource,
      referrer: document.referrer || '',
      language: navigator.language || '',
    };

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json();
      if (!res.ok || !data.ok) throw new Error('submit failed');
      window.location.href = thankYouPath;
    } catch {
      if (status) {
        status.hidden = false;
        status.textContent = 'שגיאה בשליחה. נסו שוב או כתבו ל-info@profitmedia.co.il';
        status.setAttribute('role', 'alert');
      }
    } finally {
      if (submitBtn) submitBtn.disabled = false;
      if (submitLabel) submitLabel.textContent = ctaLabel;
    }
  });
</script>

<style>
  .avhun-top {
    display: flex;
    justify-content: center;
    padding: 0.85rem 1.25rem;
    background: #fff;
    border-bottom: 1px solid rgba(101, 21, 97, 0.1);
  }

  .avhun-logo img {
    height: 2.6rem;
    width: auto;
  }

  .avhun-hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(155deg, #651561 0%, #5a1c73 58%, #3d1248 100%);
    color: #fff;
    padding: 1.75rem 1.25rem 2.25rem;
  }

  .avhun-hero__glow {
    position: absolute;
    inset-inline-end: -8rem;
    top: -6rem;
    width: 22rem;
    height: 22rem;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(252, 192, 0, 0.22), transparent 68%);
    pointer-events: none;
  }

  .avhun-hero__inner {
    position: relative;
    z-index: 1;
    max-width: 70rem;
    margin: 0 auto;
    display: grid;
    gap: 1.75rem;
  }

  @media (min-width: 960px) {
    .avhun-hero__inner {
      grid-template-columns: 1.08fr 0.92fr;
      align-items: start;
      gap: 2.75rem;
      padding-block: 1.25rem;
    }
  }

  .avhun-eyebrow {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.88);
  }

  .avhun-hero h1 {
    margin: 0.65rem 0 0;
    font-size: clamp(2rem, 4.8vw, 3.15rem);
    line-height: 1.15;
    font-weight: 900;
    text-wrap: balance;
  }

  .avhun-sub {
    margin: 0.95rem 0 0;
    font-size: 1.1rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.94);
    max-width: 36rem;
  }

  .avhun-proof-row {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.65rem;
    margin-top: 1.35rem;
  }

  @media (max-width: 959px) {
    .avhun-hero__copy {
      text-align: center;
    }

    .avhun-sub {
      margin-inline: auto;
    }

    .avhun-proof-row {
      align-items: center;
    }
  }

  .avhun-chip {
    display: inline-flex;
    margin: 0;
    padding: 0.5rem 0.9rem;
    border-radius: 9999px;
    background: #fcc000;
    color: #651561;
    font-size: 0.875rem;
    font-weight: 700;
  }

  .avhun-trust {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.84);
  }

  /* Form: tinted panel + white fields with strong border (no white-on-white) */
  .avhun-card {
    position: relative;
    background: #e8dced;
    color: #111827;
    border-radius: 1.25rem;
    border: 2px solid rgba(252, 192, 0, 0.55);
    padding: 1.55rem 1.25rem 1.4rem;
    box-shadow:
      0 22px 50px rgba(26, 10, 36, 0.35),
      inset 0 1px 0 rgba(255, 255, 255, 0.55);
  }

  @media (min-width: 768px) {
    .avhun-card {
      padding: 1.85rem 1.55rem 1.6rem;
    }
  }

  .avhun-card__badge {
    position: absolute;
    inset-inline-start: 1.15rem;
    top: -0.7rem;
    background: #fcc000;
    color: #651561;
    font-size: 0.75rem;
    font-weight: 900;
    padding: 0.28rem 0.7rem;
    border-radius: 9999px;
  }

  .avhun-card__title {
    margin: 0.35rem 0 0;
    font-size: 1.35rem;
    font-weight: 900;
    color: #651561;
  }

  .avhun-card__note {
    margin: 0.45rem 0 1.15rem;
    font-size: 0.875rem;
    line-height: 1.45;
    color: #4b5563;
  }

  .avhun-form {
    display: grid;
    gap: 0.9rem;
  }

  .avhun-field label {
    display: block;
    margin-bottom: 0.35rem;
    font-size: 0.875rem;
    font-weight: 700;
    color: #374151;
  }

  .avhun-field input[type='text'],
  .avhun-field input[type='tel'] {
    width: 100%;
    border: 2px solid #8f6a98;
    border-radius: 0.85rem;
    padding: 0.85rem 0.95rem;
    font-size: 1rem;
    font-weight: 600;
    color: #111827;
    background: #fff;
    box-shadow: inset 0 1px 2px rgba(101, 21, 97, 0.06);
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .avhun-field input::placeholder {
    color: #6b7280;
    font-weight: 600;
  }

  .avhun-field input:hover {
    border-color: #651561;
  }

  .avhun-field input:focus {
    outline: none;
    border-color: #fcc000;
    box-shadow: 0 0 0 4px rgba(252, 192, 0, 0.35);
  }

  .avhun-field input[aria-invalid='true'] {
    border-color: #dc2626;
    box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.18);
  }

  .avhun-error {
    margin: 0.35rem 0 0;
    font-size: 0.8125rem;
    font-weight: 700;
    color: #b91c1c;
  }

  .avhun-privacy {
    display: flex;
    gap: 0.65rem;
    align-items: flex-start;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: #374151;
  }

  .avhun-privacy input {
    margin-top: 0.15rem;
    width: 1.1rem;
    height: 1.1rem;
    accent-color: #651561;
    flex-shrink: 0;
  }

  .avhun-privacy a {
    color: #651561;
    text-decoration: underline;
    font-weight: 700;
  }

  .avhun-submit {
    width: 100%;
    justify-content: center;
    border: none;
    border-radius: 9999px;
    padding: 1rem 1.25rem;
    font-size: 1.0625rem;
    font-weight: 800;
    cursor: pointer;
    transition:
      transform 0.15s ease,
      box-shadow 0.2s ease;
    box-shadow: 0 8px 24px rgba(252, 192, 0, 0.35);
  }

  .avhun-submit:hover {
    transform: translateY(-1px);
  }

  .avhun-submit:active {
    transform: translateY(1px) scale(0.98);
  }

  .avhun-submit:disabled {
    opacity: 0.7;
    cursor: wait;
    transform: none;
  }

  .avhun-status {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 700;
    color: #b91c1c;
  }

  .avhun-stats {
    background: #fff;
    border-bottom: 1px solid rgba(101, 21, 97, 0.08);
    padding: 1.5rem 1.25rem;
  }

  .avhun-stats__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.95rem;
  }

  @media (min-width: 768px) {
    .avhun-stats__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.15rem;
    }
  }

  .avhun-stat {
    text-align: center;
    padding: 1.15rem 0.65rem;
    border-radius: 1.1rem;
    background: #faf7fb;
    border: 1px solid rgba(101, 21, 97, 0.1);
  }

  .avhun-stat__value {
    margin: 0;
    font-size: clamp(1.85rem, 6.5vw, 2.55rem);
    line-height: 1.05;
    font-weight: 900;
    color: #651561;
    font-variant-numeric: tabular-nums;
  }

  .avhun-stat__label {
    margin: 0.4rem 0 0;
    font-size: 0.9rem;
    font-weight: 700;
    color: #4b5563;
  }

  .avhun-clients {
    padding: 2rem 1.25rem 1.5rem;
    background: #fff;
  }

  .avhun-clients__title {
    margin: 0 0 1.15rem;
    text-align: center;
    font-size: 1.05rem;
    font-weight: 800;
    color: #4b5563;
  }

  .avhun-clients__row {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 2rem;
    justify-content: center;
    align-items: center;
  }

  .avhun-clients__row img {
    height: 3.25rem;
    width: auto;
    max-width: 9.5rem;
    object-fit: contain;
    filter: grayscale(0.35) opacity(0.9);
    transition: filter 0.2s ease;
  }

  @media (min-width: 768px) {
    .avhun-clients__row img {
      height: 3.75rem;
      max-width: 11rem;
    }
  }

  .avhun-clients__row img:hover {
    filter: none;
  }

  .avhun-section {
    padding: 2.75rem 1.25rem;
    background: #fff;
  }

  .avhun-section--soft {
    background: #faf7fb;
  }

  .avhun-wrap {
    max-width: 64rem;
    margin: 0 auto;
  }

  .avhun-wrap--narrow {
    max-width: 40rem;
  }

  .avhun-section h2 {
    margin: 0 0 1.35rem;
    font-size: clamp(1.55rem, 3vw, 2.05rem);
    font-weight: 900;
    color: #111827;
    text-align: center;
    text-wrap: balance;
  }

  .avhun-section__sub {
    margin: -0.5rem auto 1.5rem;
    max-width: 36rem;
    text-align: center;
    color: #4b5563;
    font-size: 1.05rem;
    line-height: 1.55;
  }

  .avhun-tiles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 700px) {
    .avhun-tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .avhun-tile {
    background: #faf7fb;
    border: 1px solid rgba(101, 21, 97, 0.1);
    border-radius: 1.1rem;
    padding: 1.35rem 1.2rem;
    box-shadow: 0 10px 28px rgba(101, 21, 97, 0.05);
    text-align: center;
  }

  .avhun-tile__icon {
    width: 4.25rem;
    height: 4.25rem;
    object-fit: contain;
    margin: 0 auto 0.75rem;
    display: block;
  }

  .avhun-tile h3 {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 900;
    color: #651561;
  }

  .avhun-tile p {
    margin: 0.45rem auto 0;
