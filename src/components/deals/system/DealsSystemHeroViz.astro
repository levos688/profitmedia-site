---
/**
 * A3 product-in-business-context hero visual with sample numbers.
 */
import { dealsSystemSnapshot } from '../../../data/deals';
---

<figure class="sys-hero-viz" aria-label="תמונת מצב עסקית: פגישות, עסקאות והשקעה לפי מקור">
  <div class="sys-hero-viz__stage" aria-hidden="true">
    <div class="sys-hero-viz__glow"></div>
    <div class="sys-hero-viz__window">
      <p class="sys-hero-viz__label">{dealsSystemSnapshot.label}</p>
      <div class="sys-hero-viz__grid">
        {
          dealsSystemSnapshot.metrics.map((metric) => (
            <div class="sys-hero-viz__metric">
              <p class="sys-hero-viz__value">{metric.value}</p>
              <p class="sys-hero-viz__metric-label">{metric.label}</p>
              <p class="sys-hero-viz__detail">{metric.detail}</p>
            </div>
          ))
        }
      </div>
    </div>
    <p class="sys-hero-viz__chip">{dealsSystemSnapshot.chip}</p>
  </div>
  <figcaption class="sr-only">
    דוגמה מומחשת: המערכת מחברת פגישות, עסקאות והשקעה לפי מקור פרסום, קהל ומודעה.
  </figcaption>
</figure>

<style>
  .sys-hero-viz {
    margin: 0;
    width: 100%;
    max-width: 34rem;
  }

  .sys-hero-viz__stage {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 17rem;
    overflow: hidden;
    border-radius: 4px;
    background:
      radial-gradient(circle at 78% 22%, rgba(198, 6, 145, 0.35), transparent 42%),
      linear-gradient(145deg, #3d1248 0%, #180a1d 100%);
    padding: 1.5rem 1.25rem 2.25rem;
  }

  .sys-hero-viz__glow {
    position: absolute;
    inset-inline-end: -2rem;
    top: -2rem;
    width: 14rem;
    height: 14rem;
    border-radius: 999px;
    background: rgba(252, 192, 0, 0.18);
    filter: blur(36px);
    pointer-events: none;
  }

  .sys-hero-viz__window {
    position: relative;
    z-index: 1;
    width: 100%;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.35);
    background: rgba(255, 255, 255, 0.96);
    box-shadow: 0 28px 55px rgba(0, 0, 0, 0.28);
    padding: 1rem 1rem 1.15rem;
  }

  .sys-hero-viz__label {
    margin: 0 0 0.85rem;
    font-size: 0.75rem;
    font-weight: 900;
    color: #651561;
  }

  .sys-hero-viz__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.65rem;
  }

  .sys-hero-viz__metric {
    border-radius: 4px;
    border: 1px solid rgba(101, 21, 97, 0.12);
    background: #f8f5f8;
    padding: 0.85rem 0.75rem;
  }

  .sys-hero-viz__value {
    margin: 0;
    font-size: clamp(1.35rem, 4vw, 1.75rem);
    font-weight: 900;
    line-height: 1;
    color: #651561;
  }

  .sys-hero-viz__metric-label {
    margin: 0.4rem 0 0;
    font-size: 0.8125rem;
    font-weight: 800;
    color: #29102c;
  }

  .sys-hero-viz__detail {
    margin: 0.2rem 0 0;
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1.4;
    color: #6b6470;
  }

  .sys-hero-viz__chip {
    position: absolute;
    z-index: 2;
    inset-inline-start: 0.85rem;
    bottom: 0.7rem;
    margin: 0;
    max-width: 12rem;
    border-radius: 4px;
    background: #fcc000;
    color: #4a0f46;
    font-size: 0.75rem;
    font-weight: 900;
    line-height: 1.35;
    padding: 0.65rem 0.8rem;
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.28);
  }

  @media (min-width: 1024px) {
    .sys-hero-viz {
      animation: sys-hero-in 0.85s cubic-bezier(0.22, 1, 0.36, 1) 0.12s both;
    }

    .sys-hero-viz__stage {
      min-height: 19rem;
      padding: 1.75rem 1.5rem 2.5rem;
    }
  }

  @keyframes sys-hero-in {
    from {
      transform: translateY(20px);
      opacity: 0.01;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sys-hero-viz {
      animation: none;
    }
  }
</style>
