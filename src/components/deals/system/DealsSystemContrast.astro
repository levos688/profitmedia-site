---
import Reveal from '../../Reveal.astro';
import { dealsContrast, dealsSystemSources } from '../../../data/deals';

const [adsCol, systemCol] = dealsContrast.columns;
---

<section id="contrast" class="sys-contrast section-padding below-fold" aria-labelledby="sys-contrast-title">
  <div class="mx-auto max-w-6xl px-4 md:px-6">
    <Reveal>
      <div class="sys-contrast__head">
        <p class="sys-contrast__eyebrow">{dealsContrast.eyebrow}</p>
        <h2 id="sys-contrast-title" class="sys-contrast__title">
          {dealsContrast.titleLines.map((line) => (
            <span class="sys-contrast__title-line">{line}</span>
          ))}
        </h2>
        <p class="sys-contrast__subtitle">{dealsContrast.subtitle}</p>
      </div>
    </Reveal>

    <div class="sys-contrast__layout">
      <Reveal>
        <div class="sys-contrast__board" aria-label="דוגמה מומחשת להשוואת מקורות פרסום">
          <p class="sys-contrast__board-caption">{dealsSystemSources.caption}</p>
          <div class="sys-contrast__table" role="table">
            <div class="sys-contrast__row sys-contrast__row--head" role="row">
              <span role="columnheader">מקור</span>
              <span role="columnheader">לידים</span>
              <span role="columnheader">פגישות</span>
              <span role="columnheader">עסקאות</span>
            </div>
            {
              dealsSystemSources.rows.map((row) => (
                <div class="sys-contrast__row" role="row">
                  <span role="cell">{row.source}</span>
                  <span role="cell">{row.leads}</span>
                  <span role="cell">{row.meetings}</span>
                  <span class="sys-contrast__deals" role="cell">{row.deals}</span>
                </div>
              ))
            }
          </div>
          <p class="sys-contrast__board-note">{dealsSystemSources.note}</p>
        </div>
      </Reveal>

      <Reveal delay={100}>
        <div class="sys-contrast__copy">
          <div class="sys-contrast__cols">
            <div class="sys-contrast__card sys-contrast__card--muted">
              <p class="sys-contrast__label">{adsCol.label}</p>
              <ul>
                {adsCol.rows.map((row) => <li>{row}</li>)}
              </ul>
            </div>
            <div class="sys-contrast__card sys-contrast__card--brand">
              <p class="sys-contrast__label">{systemCol.label}</p>
              <ul>
                {systemCol.rows.map((row) => <li>{row}</li>)}
              </ul>
            </div>
          </div>
          <p class="sys-contrast__closing">{dealsContrast.closing}</p>
        </div>
      </Reveal>
    </div>
  </div>
</section>

<style>
  .sys-contrast {
    background: #fff;
  }

  .sys-contrast__head {
    max-width: 44rem;
    margin-inline: auto;
    margin-bottom: 2.5rem;
    text-align: center;
  }

  .sys-contrast__eyebrow {
    margin: 0 0 0.65rem;
    font-size: 0.875rem;
    font-weight: 800;
    color: #c60691;
  }

  .sys-contrast__title {
    margin: 0;
    font-size: clamp(1.6rem, 4.6vw, 2.45rem);
    font-weight: 900;
    line-height: 1.25;
    color: #29102c;
  }

  .sys-contrast__title-line {
    display: block;
  }

  .sys-contrast__subtitle {
    margin: 0.85rem 0 0;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: #4b5563;
  }

  .sys-contrast__layout {
    display: grid;
    gap: 1.5rem;
    align-items: center; /* Changed from stretch so the board centers vertically and doesn't leave a huge void */
  }

  .sys-contrast__layout > :global([data-reveal]) {
    height: auto;
  }

  .sys-contrast__board {
    display: flex;
    flex-direction: column;
    border-radius: 8px;
    border: 1px solid rgba(101, 21, 97, 0.12);
    background: linear-gradient(165deg, #ffffff 0%, #f7f5f8 100%);
    padding: 1.6rem 1.4rem;
    box-shadow: 0 12px 35px rgba(101, 21, 97, 0.08);
  }

  .sys-contrast__board-caption {
    margin: 0 0 1.25rem;
    font-size: 1rem;
    font-weight: 800;
    line-height: 1.45;
    color: #29102c;
  }

  .sys-contrast__table {
    display: grid;
    gap: 0.5rem;
  }

  .sys-contrast__row {
    display: grid;
    grid-template-columns: 1.2fr repeat(3, 1fr);
    gap: 0.5rem;
    align-items: center;
  }

  .sys-contrast__row > span {
    border-radius: 6px;
    background: #ffffff;
    border: 1px solid #e4e4e7;
    padding: 0.85rem 0.6rem;
    text-align: center;
    font-size: 0.9rem;
    font-weight: 700;
    color: #3f3f46;
  }

  .sys-contrast__row > span:first-child {
    text-align: right;
    padding-inline: 0.85rem;
  }

  .sys-contrast__row--head > span {
    background: transparent;
    border: none;
    padding-bottom: 0.25rem;
    color: #651561;
    font-size: 0.75rem;
    font-weight: 800;
  }

  .sys-contrast__deals {
    background: #fcc000 !important;
    border-color: #e6ad00 !important;
    color: #29102c !important;
    font-weight: 900 !important;
  }

  .sys-contrast__board-note {
    margin-top: 1.25rem;
    font-size: 0.8rem;
    line-height: 1.55;
    color: #6b7280;
  }

  .sys-contrast__copy {
    display: flex;
    height: 100%;
    flex-direction: column;
  }

  .sys-contrast__cols {
    display: grid;
    gap: 1rem;
  }

  .sys-contrast__card {
    border-radius: 4px;
    padding: 1.4rem 1.25rem;
  }

  .sys-contrast__card--muted {
    background: #f4f4f5;
    border: 1px solid #e4e4e7;
  }

  .sys-contrast__card--brand {
    background: linear-gradient(160deg, #4a0f46, #651561 60%, #7d1a72);
    box-shadow: 0 18px 40px rgba(101, 21, 97, 0.2);
  }

  .sys-contrast__label {
    margin: 0 0 1rem;
    font-size: 1.05rem;
    font-weight: 900;
    color: #29102c;
  }

  .sys-contrast__card--brand .sys-contrast__label {
    color: #fcc000;
  }

  .sys-contrast__card ul {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sys-contrast__card li {
    position: relative;
    padding-inline-start: 1.25rem;
    font-size: 0.98rem;
    line-height: 1.55;
    color: #3f3f46;
  }

  .sys-contrast__card li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: 0.55rem;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: #a1a1aa;
  }

  .sys-contrast__card--brand li {
    color: rgba(255, 255, 255, 0.94);
  }

  .sys-contrast__card--brand li::before {
    background: #fcc000;
  }

  .sys-contrast__closing {
    margin: 1.35rem 0 0;
    margin-top: auto;
    padding-top: 1.35rem;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.65;
    color: #4a0f46;
  }

  @media (min-width: 1024px) {
    .sys-contrast__layout {
      grid-template-columns: 0.95fr 1.05fr;
      gap: 2rem;
    }
  }
</style>
