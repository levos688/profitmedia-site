---
import Reveal from '../Reveal.astro';
import { dealsGuard } from '../../data/deals';
---

<section class="deals-guard below-fold" aria-labelledby="deals-guard-title">
  <div class="mx-auto max-w-4xl px-4 text-center md:px-6">
    <Reveal>
      <h2 id="deals-guard-title" class="deals-guard__title">{dealsGuard.title}</h2>
      <p class="deals-guard__body">{dealsGuard.body}</p>
    </Reveal>
  </div>
</section>

<style>
  .deals-guard {
    background: linear-gradient(160deg, #1a0a24 0%, #3d1248 55%, #5a1c73 100%);
    padding-block: 3rem;
  }

  .deals-guard__title {
    margin: 0;
    font-size: clamp(1.375rem, 4.4vw, 2.05rem);
    font-weight: 800;
    line-height: 1.3;
    color: #fcc000;
  }

  .deals-guard__body {
    margin: 1.1rem auto 0;
    max-width: 42rem;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.92);
  }
</style>
