---
import Reveal from '../Reveal.astro';
import { dealsGuard } from '../../data/deals';
---

<section class="deals-guard below-fold" aria-labelledby="deals-guard-title">
  <div class="mx-auto max-w-5xl px-4 md:px-6">
    <Reveal>
      <div class="deals-guard__frame">
        <p class="deals-guard__mark" aria-hidden="true">שיפור בשתי שכבות</p>
        <h2 id="deals-guard-title" class="deals-guard__title">{dealsGuard.title}</h2>
        <p class="deals-guard__body">{dealsGuard.body}</p>
      </div>
    </Reveal>
  </div>
</section>

<style>
  .deals-guard {
    background: linear-gradient(160deg, #1a0a24 0%, #3d1248 50%, #5a1c73 100%);
    padding-block: 3.25rem;
  }

  .deals-guard__frame {
    border-radius: 4px;
    border: 1px solid rgba(252, 192, 0, 0.28);
    background: rgba(255, 255, 255, 0.04);
    padding: 2rem 1.5rem;
    text-align: center;
  }

  .deals-guard__mark {
    margin: 0 0 1rem;
    display: inline-flex;
    border-radius: 999px;
    background: rgba(252, 192, 0, 0.15);
    padding: 0.35rem 0.9rem;
    font-size: 0.8125rem;
    font-weight: 800;
    color: #fcc000;
  }

  .deals-guard__title {
    margin: 0;
    font-size: clamp(1.5rem, 4.6vw, 2.25rem);
    font-weight: 900;
    line-height: 1.25;
    color: #fcc000;
  }

  .deals-guard__body {
    margin: 1.1rem auto 0;
    max-width: 42rem;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.9);
  }

  @media (min-width: 768px) {
    .deals-guard__frame {
      padding: 2.75rem 3rem;
    }
  }
</style>
