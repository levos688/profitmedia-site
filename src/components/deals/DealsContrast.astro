---
import Reveal from '../Reveal.astro';
import { dealsContrast } from '../../data/deals';
---

<section id="contrast" class="deals-contrast section-padding below-fold" aria-labelledby="deals-contrast-title">
  <div class="mx-auto max-w-6xl px-4 md:px-6">
    <Reveal>
      <div class="deals-contrast__head">
        <p class="deals-contrast__eyebrow">{dealsContrast.eyebrow}</p>
        <h2 id="deals-contrast-title" class="deals-contrast__title">{dealsContrast.title}</h2>
        <p class="deals-contrast__subtitle">{dealsContrast.subtitle}</p>
      </div>
    </Reveal>

    <div class="deals-contrast__grid">
      {
        dealsContrast.columns.map((column, index) => (
          <Reveal delay={index * 90}>
            <div class:list={['deals-contrast__card', `deals-contrast__card--${column.tone}`]}>
              <p class="deals-contrast__label">{column.label}</p>
              <ul class="deals-contrast__list">
                {column.rows.map((row) => (
                  <li>{row}</li>
                ))}
              </ul>
            </div>
          </Reveal>
        ))
      }
    </div>

    <Reveal delay={180}>
      <p class="deals-contrast__closing">{dealsContrast.closing}</p>
    </Reveal>
  </div>
</section>

<style>
  .deals-contrast {
    background: #fff;
  }

  .deals-contrast__head {
    max-width: 46rem;
    margin-inline: auto;
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .deals-contrast__eyebrow {
    margin: 0 0 0.6rem;
    font-size: 0.875rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: #c60691;
  }

  .deals-contrast__title {
    margin: 0;
    font-size: clamp(1.5rem, 4.6vw, 2.35rem);
    font-weight: 800;
    line-height: 1.25;
    color: #29102c;
  }

  .deals-contrast__subtitle {
    margin: 0.85rem 0 0;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: #4b5563;
  }

  .deals-contrast__grid {
    display: grid;
    gap: 1rem;
  }

  .deals-contrast__card {
    height: 100%;
    border-radius: 4px;
    padding: 1.5rem 1.35rem;
  }

  .deals-contrast__card--muted {
    background: #f4f4f5;
    border: 1px solid #e4e4e7;
  }

  .deals-contrast__card--brand {
    background: linear-gradient(160deg, #4a0f46 0%, #651561 55%, #7d1a72 100%);
    border: 1px solid rgba(101, 21, 97, 0.35);
    box-shadow: 0 18px 45px rgba(101, 21, 97, 0.18);
  }

  .deals-contrast__label {
    margin: 0 0 1.1rem;
    font-size: 1.0625rem;
    font-weight: 900;
    color: #29102c;
  }

  .deals-contrast__card--brand .deals-contrast__label {
    color: #fcc000;
  }

  .deals-contrast__list {
    display: grid;
    gap: 0.85rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .deals-contrast__list li {
    position: relative;
    padding-inline-start: 1.5rem;
    font-size: 1rem;
    line-height: 1.6;
    color: #3f3f46;
  }

  .deals-contrast__list li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: 0.55rem;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: #a1a1aa;
  }

  .deals-contrast__card--brand .deals-contrast__list li {
    color: rgba(255, 255, 255, 0.94);
  }

  .deals-contrast__card--brand .deals-contrast__list li::before {
    background: #fcc000;
  }

  .deals-contrast__closing {
    margin: 2rem auto 0;
    max-width: 44rem;
    text-align: center;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.7;
    color: #4a0f46;
  }

  @media (min-width: 768px) {
    .deals-contrast__grid {
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }

    .deals-contrast__card {
      padding: 2rem 1.75rem;
    }
  }
</style>
