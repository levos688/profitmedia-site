---
import Reveal from '../Reveal.astro';
import { dealsContrast } from '../../data/deals';

const [adsCol, crmCol] = dealsContrast.columns;
---

<section id="contrast" class="deals-contrast below-fold" aria-labelledby="deals-contrast-title">
  <div class="relative mx-auto max-w-6xl px-4 md:px-6">
    <Reveal>
      <div class="deals-contrast__head">
        <p class="deals-contrast__eyebrow">{dealsContrast.eyebrow}</p>
        <h2 id="deals-contrast-title" class="deals-contrast__title">
          {dealsContrast.titleLines.map((line) => (
            <span class="deals-contrast__title-line">{line}</span>
          ))}
        </h2>
        <p class="deals-contrast__subtitle">{dealsContrast.subtitle}</p>
      </div>
    </Reveal>

    <div class="deals-contrast__stage">
      <Reveal>
        <div class="deals-contrast__panel deals-contrast__panel--ads">
          <p class="deals-contrast__panel-kicker">{adsCol.label}</p>
          <ul>
            {adsCol.rows.map((row) => <li>{row}</li>)}
          </ul>
        </div>
      </Reveal>

      <div class="deals-contrast__vs" aria-hidden="true">
        <span>מול</span>
      </div>

      <Reveal delay={100}>
        <div class="deals-contrast__panel deals-contrast__panel--crm">
          <p class="deals-contrast__panel-kicker">{crmCol.label}</p>
          <ul>
            {crmCol.rows.map((row) => <li>{row}</li>)}
          </ul>
        </div>
      </Reveal>
    </div>

    <Reveal delay={160}>
      <p class="deals-contrast__closing">{dealsContrast.closing}</p>
    </Reveal>
  </div>
</section>

<style>
  .deals-contrast {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(ellipse at 85% 10%, rgba(198, 6, 145, 0.07), transparent 38%),
      #fff;
    padding-block: 3.5rem;
  }

  .deals-contrast__head {
    position: relative;
    max-width: 44rem;
    margin-inline: auto;
    margin-bottom: 2.75rem;
    text-align: center;
  }

  .deals-contrast__eyebrow {
    margin: 0 0 0.7rem;
    font-size: 0.875rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: #c60691;
  }

  .deals-contrast__title {
    margin: 0;
    font-size: clamp(1.65rem, 4.8vw, 2.6rem);
    font-weight: 900;
    line-height: 1.25;
    color: #29102c;
  }

  .deals-contrast__title-line {
    display: block;
  }

  .deals-contrast__subtitle {
    margin: 0.95rem 0 0;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: #4b5563;
  }

  .deals-contrast__stage {
    position: relative;
    display: grid;
    gap: 1rem;
  }

  .deals-contrast__stage > :global([data-reveal]) {
    height: 100%;
  }

  .deals-contrast__panel {
    height: 100%;
    border-radius: 4px;
    padding: 1.75rem 1.5rem;
  }

  .deals-contrast__panel--ads {
    background: #f4f4f5;
    border: 1px solid #e4e4e7;
  }

  .deals-contrast__panel--crm {
    background: #f7eff8;
    border: 1px solid rgba(101, 21, 97, 0.22);
    box-shadow: 0 18px 45px rgba(101, 21, 97, 0.1);
  }

  .deals-contrast__panel-kicker {
    margin: 0 0 1.25rem;
    font-size: 1.125rem;
    font-weight: 900;
    color: #29102c;
  }

  .deals-contrast__panel--crm .deals-contrast__panel-kicker {
    color: #651561;
  }

  .deals-contrast__panel ul {
    display: grid;
    gap: 0.95rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .deals-contrast__panel li {
    position: relative;
    padding-inline-start: 1.35rem;
    font-size: 1.02rem;
    line-height: 1.55;
    color: #3f3f46;
  }

  .deals-contrast__panel li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: 0.55rem;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: #a1a1aa;
  }

  .deals-contrast__panel--crm li::before {
    background: #651561;
  }

  .deals-contrast__vs {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .deals-contrast__vs span {
    display: inline-flex;
    min-width: 3.25rem;
    min-height: 3.25rem;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: #fcc000;
    color: #4a0f46;
    font-size: 0.9375rem;
    font-weight: 900;
  }

  .deals-contrast__closing {
    position: relative;
    margin: 2.25rem auto 0;
    max-width: 40rem;
    text-align: center;
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.7;
    color: #4a0f46;
  }

  @media (min-width: 900px) {
    .deals-contrast {
      padding-block: 5rem;
    }

    .deals-contrast__stage {
      grid-template-columns: 1fr auto 1fr;
      align-items: stretch;
      gap: 1.25rem;
    }

    .deals-contrast__vs {
      align-self: center;
    }

    .deals-contrast__panel {
      padding: 2.25rem 2rem;
      min-height: 100%;
    }
  }

</style>
