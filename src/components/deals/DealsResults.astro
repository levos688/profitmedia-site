---
import Reveal from '../Reveal.astro';
import { dealsResults } from '../../data/deals';
---

<section id="results" class="deals-results section-padding below-fold" aria-labelledby="deals-results-title">
  <div class="mx-auto max-w-6xl px-4 md:px-6">
    <div class="deals-results__layout">
      <Reveal class="deals-results__copy">
        <h2 id="deals-results-title" class="deals-results__title">{dealsResults.title}</h2>
        <p class="deals-results__body">{dealsResults.body}</p>

        <div class="deals-results__honesty">
          <p>{dealsResults.honesty}</p>
        </div>

        <p class="deals-results__disclaimer">{dealsResults.disclaimer}</p>
      </Reveal>

      <Reveal class="deals-results__chart-wrap" delay={120}>
        <figure class="deals-results__chart" aria-label="השוואת עסקאות לחודש לפני ואחרי">
          <div class="deals-results__cols">
            {
              dealsResults.bars.map((bar) => (
                <div class:list={['deals-col', `deals-col--${bar.tone}`]}>
                  <div class="deals-col__visual">
                    <div class="deals-col__fill" style={`--bar-ratio:${bar.ratio}`}>
                      <span class="deals-col__value">{bar.value}</span>
                    </div>
                  </div>
                  <p class="deals-col__label">{bar.label}</p>
                </div>
              ))
            }
          </div>
          <figcaption>{dealsResults.barsCaption}</figcaption>
        </figure>
      </Reveal>
    </div>
  </div>
</section>

<style>
  .deals-results {
    background:
      radial-gradient(ellipse at 15% 0%, rgba(198, 6, 145, 0.08), transparent 45%),
      #f7f5f8;
  }

  .deals-results__layout {
    display: grid;
    gap: 2.5rem;
  }

  .deals-results__title {
    margin: 0;
    font-size: clamp(1.65rem, 4.8vw, 2.5rem);
    font-weight: 900;
    line-height: 1.2;
    color: #29102c;
    text-wrap: pretty;
  }

  .deals-results__body {
    margin: 1.1rem 0 0;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: #4b5563;
  }

  .deals-results__honesty {
    margin-top: 1.5rem;
    border-inline-start: 4px solid #fcc000;
    background: #fff;
    border-radius: 4px;
    padding: 1.2rem 1.35rem;
    box-shadow: 0 14px 40px rgba(101, 21, 97, 0.07);
  }

  .deals-results__honesty p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.7;
    color: #3f3f46;
  }

  .deals-results__disclaimer {
    margin: 1rem 0 0;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: #6b5570;
  }

  .deals-results__chart {
    margin: 0;
    border-radius: 4px;
    background: #fff;
    border: 1px solid rgba(101, 21, 97, 0.1);
    box-shadow: 0 22px 55px rgba(101, 21, 97, 0.1);
    padding: 1.75rem 1.25rem 1.4rem;
  }

  .deals-results__cols {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
    align-items: end;
    min-height: 16rem;
  }

  .deals-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-align: center;
  }

  .deals-col__visual {
    display: flex;
    width: 100%;
    height: 14rem;
    align-items: flex-end;
    justify-content: center;
  }

  .deals-col__fill {
    display: flex;
    width: 100%;
    max-width: 5.5rem;
    height: calc(var(--bar-ratio) * 100%);
    align-items: flex-start;
    justify-content: center;
    padding-top: 0.85rem;
    border-radius: 4px 4px 0 0;
    background: linear-gradient(180deg, #d8cddd 0%, #b9adbe 100%);
    transform-origin: bottom center;
    animation: deals-col-rise 0.85s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .deals-col--now .deals-col__fill {
    background: linear-gradient(180deg, #c60691 0%, #651561 100%);
    box-shadow: 0 18px 35px rgba(101, 21, 97, 0.28);
  }

  .deals-col__value {
    font-size: clamp(1.25rem, 3.5vw, 1.75rem);
    font-weight: 900;
    line-height: 1;
    color: #29102c;
  }

  .deals-col--now .deals-col__value {
    color: #fff;
  }

  .deals-col__label {
    margin: 0;
    min-height: 2.6rem;
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.35;
    color: #4b5563;
  }

  .deals-col--now .deals-col__label {
    color: #4a0f46;
    font-weight: 900;
  }

  .deals-results__chart figcaption {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(101, 21, 97, 0.1);
    font-size: 0.8125rem;
    line-height: 1.6;
    color: #6b5570;
    text-align: center;
  }

  @keyframes deals-col-rise {
    from {
      transform: scaleY(0.08);
      opacity: 0.35;
    }
    to {
      transform: scaleY(1);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .deals-col__fill {
      animation: none;
    }
  }

  @media (min-width: 1024px) {
    .deals-results__layout {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 3.5rem;
      align-items: center;
    }

    .deals-results__chart {
      padding: 2.25rem 2rem 1.6rem;
    }

    .deals-results__cols {
      min-height: 18rem;
      gap: 1.25rem;
    }

    .deals-col__visual {
      height: 16rem;
    }

    .deals-col__fill {
      max-width: 6.5rem;
    }
  }
</style>
