---
import Reveal from '../Reveal.astro';
import { dealsResults } from '../../data/deals';
---

<section id="results" class="deals-results section-padding below-fold" aria-labelledby="deals-results-title">
  <div class="mx-auto max-w-6xl px-4 md:px-6">
    <div class="deals-results__layout">
      <Reveal class="deals-results__copy">
        <h2 id="deals-results-title" class="deals-results__title">{dealsResults.title}</h2>
        <p class="deals-results__body">{dealsResults.body}</p>

        <div class="deals-results__honesty">
          <p>{dealsResults.honesty}</p>
        </div>

        <p class="deals-results__disclaimer">{dealsResults.disclaimer}</p>
      </Reveal>

      <Reveal class="deals-results__chart-wrap" delay={120}>
        <figure class="deals-results__chart">
          <div class="deals-results__bars">
            {
              dealsResults.bars.map((bar) => (
                <div class:list={['deals-bar', `deals-bar--${bar.tone}`]}>
                  <div class="deals-bar__track">
                    <div class="deals-bar__fill" style={`--bar-ratio:${bar.ratio}`}>
                      <span class="deals-bar__value">{bar.value}</span>
                    </div>
                  </div>
                  <p class="deals-bar__label">{bar.label}</p>
                </div>
              ))
            }
          </div>
          <figcaption>{dealsResults.barsCaption}</figcaption>
        </figure>
      </Reveal>
    </div>
  </div>
</section>

<style>
  .deals-results {
    background: #f7f5f8;
  }

  .deals-results__layout {
    display: grid;
    gap: 2rem;
  }

  .deals-results__title {
    margin: 0;
    font-size: clamp(1.5rem, 4.6vw, 2.25rem);
    font-weight: 800;
    line-height: 1.25;
    color: #29102c;
  }

  .deals-results__body {
    margin: 1rem 0 0;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: #4b5563;
  }

  .deals-results__honesty {
    margin-top: 1.5rem;
    border-inline-start: 3px solid #fcc000;
    background: #fff;
    border-radius: 4px;
    padding: 1.1rem 1.25rem;
  }

  .deals-results__honesty p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.7;
    color: #3f3f46;
  }

  .deals-results__disclaimer {
    margin: 1rem 0 0;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: #6b5570;
  }

  .deals-results__chart {
    margin: 0;
    border-radius: 4px;
    background: #fff;
    border: 1px solid rgba(101, 21, 97, 0.12);
    box-shadow: 0 12px 40px rgba(101, 21, 97, 0.07);
    padding: 1.5rem 1.35rem;
  }

  .deals-results__bars {
    display: grid;
    gap: 1.25rem;
  }

  .deals-bar__track {
    display: flex;
    border-radius: 4px;
    background: rgba(101, 21, 97, 0.07);
  }

  .deals-bar__fill {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    min-width: 3.5rem;
    width: calc(var(--bar-ratio) * 100%);
    height: 2.75rem;
    padding-inline-end: 0.85rem;
    border-radius: 4px;
    background: #cdc3d1;
    transform-origin: right center;
    animation: deals-bar-grow 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .deals-bar--now .deals-bar__fill {
    background: linear-gradient(90deg, #c60691 0%, #651561 100%);
  }

  .deals-bar__value {
    font-size: 1.125rem;
    font-weight: 900;
    color: #29102c;
  }

  .deals-bar--now .deals-bar__value {
    color: #fff;
  }

  .deals-bar__label {
    margin: 0.5rem 0 0;
    font-size: 0.9375rem;
    font-weight: 600;
    color: #4b5563;
  }

  .deals-bar--now .deals-bar__label {
    color: #4a0f46;
    font-weight: 800;
  }

  .deals-results__chart figcaption {
    margin-top: 1.35rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(101, 21, 97, 0.1);
    font-size: 0.8125rem;
    line-height: 1.6;
    color: #6b5570;
  }

  /* Bars grow on reveal so the "before / after" contrast reads as a change over time. */
  @keyframes deals-bar-grow {
    from {
      transform: scaleX(0.05);
      opacity: 0.4;
    }
    to {
      transform: scaleX(1);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .deals-bar__fill {
      animation: none;
    }
  }

  @media (min-width: 1024px) {
    .deals-results__layout {
      grid-template-columns: 1fr 1fr;
      gap: 3.5rem;
      align-items: center;
    }

    .deals-results__chart {
      padding: 2rem 1.75rem;
    }
  }
</style>
