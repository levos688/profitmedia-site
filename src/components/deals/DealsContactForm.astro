---
import CheckIcon from '../icons/CheckIcon.astro';
import Reveal from '../Reveal.astro';
import PremiumAtmosphere from '../preview/PremiumAtmosphere.astro';
import { formPlaceholders, formLabels } from '../../data/site';
import { dealsForm } from '../../data/deals';
---

<section id="contact" class="preview-contact-depth contact-section section-padding below-fold relative overflow-hidden">
  <PremiumAtmosphere variant="contact" />

  <div class="relative mx-auto max-w-6xl px-4 md:px-6">
    <Reveal>
      <div class="grid items-start gap-12 lg:grid-cols-2 lg:gap-16 xl:gap-20">
        <div class="order-2 flex flex-col justify-center text-right text-white max-lg:items-center max-lg:text-center lg:order-none lg:min-h-[28rem]">
          <blockquote class="mb-8 max-w-md text-lg font-bold leading-relaxed text-white/95 md:text-xl">
            "{dealsForm.quote}"
            <footer class="mt-3 text-base font-semibold text-white/75">{dealsForm.quoteAuthor}</footer>
          </blockquote>

          <ul class="contact-benefits space-y-5 text-lg text-white/90 md:text-xl lg:space-y-6" aria-label="מה מקבלים">
            {
              dealsForm.benefits.map((benefit) => (
                <li class="flex items-center justify-start gap-3.5 max-lg:justify-center">
                  <span class="contact-check" aria-hidden="true">
                    <CheckIcon />
                  </span>
                  <span>{benefit}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="deals-form-column order-1 w-full max-w-lg justify-self-center lg:order-none lg:max-w-none lg:justify-self-auto">
          <div class="deals-form-heading mb-8 w-full text-center text-white md:mb-10 lg:text-right">
            <p class="mb-3 font-semibold text-white/85">{dealsForm.eyebrow}</p>
            <h2 class="deals-form-title w-full font-black leading-tight">{dealsForm.title}</h2>
          </div>

          <form
            class="contact-form w-full"
            method="POST"
            action="#"
            id="deals-contact-form"
            novalidate
            autocomplete="off"
          >
            <div class="space-y-2.5 md:space-y-3.5">
              <div class="field-group">
                <label for="deals-name" class="preview-contact-label">{formLabels.name}</label>
                <input
                  type="text"
                  id="deals-name"
                  name="name"
                  required
                  autocomplete="name"
                  class="contact-input"
                  placeholder={formPlaceholders.name}
                  aria-describedby="deals-name-error"
                />
                <p id="deals-name-error" class="field-error hidden" role="alert"></p>
              </div>

              <div class="field-group">
                <label for="deals-phone" class="preview-contact-label">{formLabels.phone}</label>
                <input
                  type="tel"
                  id="deals-phone"
                  name="phone"
                  required
                  inputmode="tel"
                  autocomplete="tel"
                  pattern="[0-9\-+() ]{9,15}"
                  class="contact-input"
                  placeholder={formPlaceholders.phone}
                  aria-describedby="deals-phone-error"
                />
                <p id="deals-phone-error" class="field-error hidden" role="alert"></p>
              </div>

              <div class="field-group">
                <label for="deals-vertical" class="preview-contact-label">{formLabels.vertical}</label>
                <input
                  type="text"
                  id="deals-vertical"
                  name="vertical"
                  required
                  autocomplete="organization-title"
                  class="contact-input"
                  placeholder={formPlaceholders.vertical}
                  aria-describedby="deals-vertical-error"
                />
                <p id="deals-vertical-error" class="field-error hidden" role="alert"></p>
              </div>
            </div>

            <label class="contact-privacy mt-5 flex cursor-pointer items-start gap-3">
              <input
                type="checkbox"
                id="deals-privacy"
                name="privacy"
                required
                class="contact-checkbox mt-0.5 shrink-0"
                aria-describedby="deals-privacy-error"
              />
              <span class="text-right text-sm leading-relaxed text-white/75">
                קראתי ואני מאשר/ת את{' '}
                <a href="/prat" class="text-brand-yellow underline underline-offset-2 hover:text-white"
                  >מדיניות הפרטיות</a
                >, ומסכים/ה לשמירת המידע לצורך טיפול בפנייתי (חובה)
              </span>
            </label>
            <p id="deals-privacy-error" class="field-error mt-2 hidden text-right" role="alert"></p>

            <button type="submit" id="deals-contact-submit" class="btn-yellow contact-submit mt-6 w-full rounded-full">
              <span id="deals-contact-submit-label" data-ab-bottom-submit>{dealsForm.submit}</span>
            </button>

            <p
              id="deals-form-status"
              class="form-success mt-4 hidden text-center text-sm font-semibold"
              role="status"
              aria-live="polite"
            >
            </p>
          </form>
        </div>
      </div>
    </Reveal>
  </div>
</section>

<script>
  function getLeadPageMeta() {
    const el = document.querySelector('[data-lead-page]') as HTMLElement | null;
    return {
      formSource: el?.dataset.leadSource || 'deals-lp-form',
      thankYou: el?.dataset.thankYou || '/ads/thank-you',
    };
  }

  const form = document.getElementById('deals-contact-form') as HTMLFormElement | null;
  const status = document.getElementById('deals-form-status');
  const submitBtn = document.getElementById('deals-contact-submit') as HTMLButtonElement | null;
  const submitLabel = document.getElementById('deals-contact-submit-label');
  const defaultSubmitLabel = submitLabel?.textContent || 'קבלו אבחון קמפיין חינם';

  const fields = {
    name: {
      input: document.getElementById('deals-name') as HTMLInputElement | null,
      error: document.getElementById('deals-name-error'),
      message: 'נא להזין שם מלא',
    },
    phone: {
      input: document.getElementById('deals-phone') as HTMLInputElement | null,
      error: document.getElementById('deals-phone-error'),
      message: 'נא להזין מספר טלפון תקין',
    },
    vertical: {
      input: document.getElementById('deals-vertical') as HTMLInputElement | null,
      error: document.getElementById('deals-vertical-error'),
      message: 'נא להזין את תחום העסק',
    },
    privacy: {
      input: document.getElementById('deals-privacy') as HTMLInputElement | null,
      error: document.getElementById('deals-privacy-error'),
      message: 'יש לאשר את מדיניות הפרטיות',
    },
  };

  const setFieldError = (key: keyof typeof fields, show: boolean) => {
    const field = fields[key];
    if (!field.input || !field.error) return;
    field.input.classList.toggle('contact-input--error', show);
    field.input.setAttribute('aria-invalid', show ? 'true' : 'false');
    field.error.textContent = show ? field.message : '';
    field.error.classList.toggle('hidden', !show);
  };

  const validate = () => {
    let valid = true;
    if (!fields.name.input?.value.trim()) {
      setFieldError('name', true);
      valid = false;
    } else setFieldError('name', false);

    const phone = fields.phone.input?.value.trim() ?? '';
    if (!phone || !/^[0-9\-+() ]{9,15}$/.test(phone)) {
      setFieldError('phone', true);
      valid = false;
    } else setFieldError('phone', false);

    if (!fields.vertical.input?.value.trim()) {
      setFieldError('vertical', true);
      valid = false;
    } else setFieldError('vertical', false);

    if (!fields.privacy.input?.checked) {
      setFieldError('privacy', true);
      valid = false;
    } else setFieldError('privacy', false);

    return valid;
  };

  Object.values(fields).forEach((field) => {
    field.input?.addEventListener('blur', validate);
    field.input?.addEventListener('input', () => {
      if (field.input?.getAttribute('aria-invalid') === 'true') validate();
    });
    field.input?.addEventListener('change', () => {
      if (field.input?.getAttribute('aria-invalid') === 'true') validate();
    });
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    status?.classList.add('hidden');
    if (!validate()) {
      const firstInvalid = form.querySelector<HTMLElement>('[aria-invalid="true"]');
      firstInvalid?.focus();
      return;
    }

    if (submitBtn) submitBtn.disabled = true;
    if (submitLabel) submitLabel.textContent = 'שולח…';

    const meta = getLeadPageMeta();
    const attr =
      typeof window.pmGetLeadAttribution === 'function'
        ? window.pmGetLeadAttribution()
        : { utm: {}, landingUrl: window.location.href };
    const payload = {
      name: fields.name.input?.value.trim(),
      phone: fields.phone.input?.value.trim(),
      email: '',
      vertical: fields.vertical.input?.value.trim() || '',
      verticalLabel: fields.vertical.input?.value.trim() || '',
      pageUrl: window.location.href,
      landingUrl: attr.landingUrl,
      utm: attr.utm,
      source: meta.formSource,
      formType: 'inline_form',
      referrer: document.referrer || '',
      language: navigator.language || '',
      device: typeof window.pmDeviceClass === 'function' ? window.pmDeviceClass() : 'Desk',
    };

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = (await res.json()) as { ok?: boolean };
      if (!res.ok || !data.ok) throw new Error('submit failed');
      await window.pmLpAb?.trackConversion?.('inline_form');
      window.location.href = meta.thankYou;
    } catch {
      if (status) {
        status.textContent = 'שגיאה בשליחה. נסו שוב או כתבו ל-info@profitmedia.co.il';
        status.classList.remove('hidden');
        status.setAttribute('role', 'alert');
      }
    } finally {
      if (submitBtn) submitBtn.disabled = false;
      if (submitLabel) submitLabel.textContent = defaultSubmitLabel;
    }
  });
</script>

<style>
  .deals-form-title {
    font-size: clamp(1.25rem, 4.2vw, 2.5rem);
  }

  .deals-form-column {
    margin-inline: auto;
    width: 100%;
  }

  @media (max-width: 1023px) {
    .deals-form-column {
      justify-self: center;
      margin-inline: auto;
      max-width: min(32rem, 100%);
    }

    .deals-form-heading,
    .deals-form-heading .deals-form-title {
      text-align: center;
    }
  }

  @media (min-width: 1024px) {
    .deals-form-column {
      margin-inline: 0;
    }
  }

  @media (max-width: 767px) {
    .deals-form-heading {
      margin-bottom: 1.25rem;
      text-align: center;
    }

    .preview-contact-label {
      font-size: 0.875rem;
      margin-bottom: 0.25rem;
    }
  }
</style>
