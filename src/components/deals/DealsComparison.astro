---
import Reveal from '../Reveal.astro';
import { dealsComparison } from '../../data/deals';
---

<section id="comparison" class="deals-compare section-padding below-fold" aria-labelledby="deals-compare-title">
  <div class="mx-auto max-w-6xl px-4 md:px-6">
    <Reveal>
      <div class="deals-compare__head">
        <h2 id="deals-compare-title" class="deals-compare__title">{dealsComparison.title}</h2>
        <p class="deals-compare__subtitle">{dealsComparison.subtitle}</p>
      </div>
    </Reveal>

    <Reveal delay={80}>
      <div class="deals-compare__board" role="table" aria-label="השוואה בין סוכנות רגילה, כלים מהמדף ומערכת Profit Media">
        <div class="deals-compare__row deals-compare__row--head" role="row">
          <div role="columnheader" class="deals-compare__cell deals-compare__cell--label"><span class="sr-only">קריטריון</span></div>
          {
            dealsComparison.columns.map((column, index) => (
              <div
                role="columnheader"
                class:list={['deals-compare__cell', index === 2 && 'is-highlight']}
              >
                {column}
              </div>
            ))
          }
        </div>

        {
          dealsComparison.rows.map((row) => (
            <div class="deals-compare__row" role="row">
              <div role="rowheader" class="deals-compare__cell deals-compare__cell--label">
                {row.label}
              </div>
              {row.values.map((value, index) => (
                <div role="cell" class:list={['deals-compare__cell', index === 2 && 'is-highlight']}>
                  {value}
                </div>
              ))}
            </div>
          ))
        }
      </div>
    </Reveal>

    <div class="deals-compare__cards">
      {
        dealsComparison.rows.map((row, rowIndex) => (
          <Reveal delay={Math.min(rowIndex * 60, 240)}>
            <div class="deals-compare__card">
              <p class="deals-compare__card-label">{row.label}</p>
              <dl>
                {row.values.map((value, index) => (
                  <div class:list={['deals-compare__pair', index === 2 && 'is-highlight']}>
                    <dt>{dealsComparison.columns[index]}</dt>
                    <dd>{value}</dd>
                  </div>
                ))}
              </dl>
            </div>
          </Reveal>
        ))
      }
    </div>

    <Reveal delay={140}>
      <p class="deals-compare__closing">{dealsComparison.closing}</p>
    </Reveal>
  </div>
</section>

<style>
  .deals-compare {
    background:
      radial-gradient(ellipse at 85% 0%, rgba(101, 21, 97, 0.07), transparent 40%),
      #f7f5f8;
  }

  .deals-compare__head {
    max-width: 42rem;
    margin-inline: auto;
    margin-bottom: 2.5rem;
    text-align: center;
  }

  .deals-compare__title {
    margin: 0;
    font-size: clamp(1.65rem, 4.8vw, 2.5rem);
    font-weight: 900;
    line-height: 1.2;
    color: #29102c;
  }

  .deals-compare__subtitle {
    margin: 0.9rem 0 0;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: #4b5563;
  }

  .deals-compare__board {
    display: none;
  }

  .deals-compare__row {
    display: grid;
    grid-template-columns: 9.5rem repeat(3, 1fr);
  }

  .deals-compare__row--head .deals-compare__cell {
    font-weight: 900;
  }

  .deals-compare__cell {
    padding: 1.1rem 1rem;
    font-size: 0.98rem;
    line-height: 1.55;
    color: #3f3f46;
    background: #fff;
    border-bottom: 1px solid rgba(101, 21, 97, 0.1);
  }

  .deals-compare__cell--label {
    font-weight: 900;
    color: #29102c;
    background: #faf7fb;
  }

  .deals-compare__row--head .deals-compare__cell:not(.deals-compare__cell--label) {
    background: #efe8f1;
    color: #29102c;
  }

  .deals-compare__cell.is-highlight {
    background: #651561;
    color: #fff;
    font-weight: 700;
  }

  .deals-compare__row--head .deals-compare__cell.is-highlight {
    background: #4a0f46;
    color: #fcc000;
  }

  .deals-compare__row:first-child .deals-compare__cell:first-child {
    border-start-start-radius: 4px;
  }

  .deals-compare__row:first-child .deals-compare__cell:last-child {
    border-start-end-radius: 4px;
  }

  .deals-compare__row:last-child .deals-compare__cell:first-child {
    border-end-start-radius: 4px;
  }

  .deals-compare__row:last-child .deals-compare__cell:last-child {
    border-end-end-radius: 4px;
  }

  .deals-compare__cards {
    display: grid;
    gap: 0.9rem;
  }

  .deals-compare__card {
    border-radius: 4px;
    background: #fff;
    border: 1px solid rgba(101, 21, 97, 0.12);
    padding: 1.25rem;
    box-shadow: 0 12px 30px rgba(101, 21, 97, 0.05);
  }

  .deals-compare__card-label {
    margin: 0 0 0.9rem;
    font-size: 1.0625rem;
    font-weight: 900;
    color: #29102c;
  }

  .deals-compare__card dl {
    display: grid;
    gap: 0.55rem;
    margin: 0;
  }

  .deals-compare__pair {
    border-radius: 4px;
    padding: 0.65rem 0.8rem;
    background: #f7f5f8;
  }

  .deals-compare__pair.is-highlight {
    background: #651561;
  }

  .deals-compare__pair dt {
    font-size: 0.8125rem;
    font-weight: 800;
    color: #6b5570;
  }

  .deals-compare__pair.is-highlight dt {
    color: #fcc000;
  }

  .deals-compare__pair dd {
    margin: 0.15rem 0 0;
    font-size: 0.95rem;
    line-height: 1.55;
    color: #3f3f46;
  }

  .deals-compare__pair.is-highlight dd {
    color: rgba(255, 255, 255, 0.95);
    font-weight: 600;
  }

  .deals-compare__closing {
    margin: 2rem auto 0;
    max-width: 42rem;
    text-align: center;
    font-size: 1.02rem;
    font-weight: 700;
    line-height: 1.7;
    color: #4a0f46;
  }

  @media (min-width: 960px) {
    .deals-compare__board {
      display: block;
      overflow: hidden;
      border-radius: 4px;
      border: 1px solid rgba(101, 21, 97, 0.12);
      box-shadow: 0 22px 50px rgba(101, 21, 97, 0.08);
    }

    .deals-compare__cards {
      display: none;
    }
  }
</style>
