---
import { homeNav as defaultNav, homeCta as defaultCta } from '../data/site';
import { normalizeLocale, type Locale } from '../i18n/config';
import type { HomeContent } from '../i18n/he/home';
import { getLocalizedPath, type RouteId } from '../i18n/routes';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale?: Locale;
  routeId?: RouteId;
  nav?: HomeContent['nav'];
  cta?: string;
}

const locale = normalizeLocale(Astro.props.locale);
const { routeId, nav = defaultNav, cta = defaultCta } = Astro.props;
const homePath = getLocalizedPath('home', locale);

const navLinkId = (href: string) => {
  const hash = href.includes('#') ? href.split('#')[1] : '';
  return hash || undefined;
};

const localizeNavHref = (href: string) => {
  const hashIndex = href.indexOf('#');
  if (hashIndex >= 0) return `${homePath}${href.slice(hashIndex)}`;
  if (href === '/about') return getLocalizedPath('about', locale);
  if (href === '/blog') return getLocalizedPath('blog', locale);
  return href;
};

const labels = locale === 'he'
  ? {
      home: 'Profit Media — דף הבית',
      primaryNav: 'ניווט ראשי',
      mobileNav: 'ניווט נייד',
      menuOpen: 'פתיחת תפריט',
      menuClose: 'סגירת תפריט',
    }
  : {
      home: 'Profit Media — главная',
      primaryNav: 'Основная навигация',
      mobileNav: 'Мобильная навигация',
      menuOpen: 'Открыть меню',
      menuClose: 'Закрыть меню',
    };
---

<header class="site-header sticky top-0 z-50 border-b border-gray-100 bg-white/95 backdrop-blur transition-shadow duration-300" id="site-header">
  <div class="header-bar mx-auto flex w-full max-w-6xl min-w-0 items-center gap-3 px-4 py-3 md:gap-4 md:px-6 lg:flex-row">
    <a href={homePath} class="header-logo block shrink-0" aria-label={labels.home}>
      <img
        src="/logo.svg"
        alt="Profit Media"
        class="header-logo__img"
        width="200"
        height="70"
      />
    </a>

    <nav class="hidden min-w-0 flex-1 items-center justify-end gap-0.5 lg:flex" aria-label={labels.primaryNav}>
      {
        nav.map((item) => (
          <a href={localizeNavHref(item.href)} class="nav-link" data-nav-link={navLinkId(item.href)}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="header-lang hidden shrink-0 lg:block">
      <LanguageSwitcher locale={locale} routeId={routeId} />
    </div>

    <button
      type="button"
      id="mobile-menu-btn"
      class="mobile-menu-btn ms-auto lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label={labels.menuOpen}
      data-open-label={labels.menuOpen}
      data-close-label={labels.menuClose}
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M4 7h16M4 12h16M4 17h16"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <nav
    id="mobile-menu"
    class="mobile-menu hidden border-t border-gray-100 bg-white lg:hidden"
    aria-label={labels.mobileNav}
    hidden
  >
    <div class="mx-auto max-w-6xl px-4 py-4">
      <ul class="space-y-1">
        {
          nav.map((item) => (
            <li>
              <a href={localizeNavHref(item.href)} class="mobile-nav-link" data-nav-link={navLinkId(item.href)}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <button
        type="button"
        class="btn-yellow mt-4 flex w-full items-center justify-center rounded-full py-3 text-base font-black"
        data-lead-modal-open
        data-cta="header_cta"
      >
        {cta}
      </button>
      <div class="mt-4 flex justify-center">
        <LanguageSwitcher locale={locale} routeId={routeId} />
      </div>
    </div>
  </nav>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  const setMenuOpen = (open: boolean) => {
    if (!menuBtn || !mobileMenu) return;
    menuBtn.setAttribute('aria-expanded', String(open));
    menuBtn.setAttribute(
      'aria-label',
      open ? menuBtn.dataset.closeLabel || '' : menuBtn.dataset.openLabel || ''
    );
    mobileMenu.hidden = !open;
    mobileMenu.classList.toggle('hidden', !open);
  };

  menuBtn?.addEventListener('click', () => {
    const isOpen = menuBtn.getAttribute('aria-expanded') === 'true';
    setMenuOpen(!isOpen);
  });

  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMenuOpen(false));
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menuBtn?.getAttribute('aria-expanded') === 'true') {
      setMenuOpen(false);
      menuBtn.focus();
    }
  });

  const siteHeader = document.getElementById('site-header');

  const sectionIds = ['for-whom', 'testimonials', 'how-it-works', 'services', 'portfolio', 'clients', 'contact'];
  const navLinks = document.querySelectorAll('[data-nav-link]');
  const sectionTops = new Map<string, number>();

  const measureSections = () => {
    sectionTops.clear();
    for (const id of sectionIds) {
      const el = document.getElementById(id);
      if (el) sectionTops.set(id, el.offsetTop);
    }
  };

  let navTicking = false;
  const updateActiveNav = () => {
    navTicking = false;
    const scrollY = window.scrollY + 120;
    let current = '';
    for (const id of sectionIds) {
      const top = sectionTops.get(id);
      if (top !== undefined && top <= scrollY) current = id;
    }
    navLinks.forEach((link) => {
      const href = link.getAttribute('data-nav-link');
      link.classList.toggle('nav-link--active', href === current);
    });
  };

  const queueActiveNav = () => {
    if (navTicking) return;
    navTicking = true;
    requestAnimationFrame(updateActiveNav);
  };

  let headerTicking = false;
  const onHeaderScroll = () => {
    headerTicking = false;
    if (!siteHeader) return;
    siteHeader.classList.toggle('site-header--scrolled', window.scrollY > 12);
  };

  const queueHeaderScroll = () => {
    if (headerTicking) return;
    headerTicking = true;
    requestAnimationFrame(onHeaderScroll);
  };

  let measureTicking = false;
  const queueMeasureSections = () => {
    if (measureTicking) return;
    measureTicking = true;
    requestAnimationFrame(() => {
      measureSections();
      measureTicking = false;
    });
  };

  requestAnimationFrame(measureSections);
  window.addEventListener('scroll', queueActiveNav, { passive: true });
  window.addEventListener('scroll', queueHeaderScroll, { passive: true });
  window.addEventListener('resize', queueMeasureSections, { passive: true });
  updateActiveNav();
  onHeaderScroll();
</script>

<style>
  .site-header--scrolled {
    box-shadow: 0 8px 28px rgba(101, 21, 97, 0.08);
    border-color: rgba(101, 21, 97, 0.08);
  }

  .header-logo__img {
    display: block;
    width: auto;
    height: 2rem; /* 32px — mobile */
    max-width: min(148px, 42vw);
  }

  @media (min-width: 768px) {
    .header-logo__img {
      height: 3.25rem; /* 52px */
      max-width: 200px;
    }
  }

  @media (min-width: 1024px) {
    .header-logo__img {
      height: 3.75rem; /* 60px — frees horizontal room for larger nav */
      max-width: 200px;
    }

    .header-bar :global(.nav-link) {
      font-size: 1.0625rem;
      font-weight: 800;
      padding-inline: 0.65rem;
      white-space: nowrap;
    }
  }

  @media (max-width: 1023px) {
    .header-bar {
      flex-direction: row;
      direction: ltr;
      justify-content: space-between;
    }
  }
</style>
