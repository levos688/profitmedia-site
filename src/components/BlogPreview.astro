---
import BlogCard from './blog/BlogCard.astro';
import { getBlogPosts, type BlogPostData } from '../lib/blog';
import type { Locale } from '../i18n/config';
import type { UiStrings } from '../i18n/he/ui';
import { getUi } from '../i18n/content';
import { getLocalizedPath } from '../i18n/routes';

interface Props {
  posts?: readonly BlogPostData[];
  locale?: Locale;
  labels?: UiStrings['blog'];
  blogHref?: string;
  showWhenEmpty?: boolean;
}

const {
  posts: providedPosts,
  locale = 'he',
  labels: providedLabels,
  blogHref: providedBlogHref,
  showWhenEmpty = false,
} = Astro.props;
const labels = providedLabels ?? getUi(locale).blog;
const blogHref = providedBlogHref ?? getLocalizedPath('blog', locale);
const defaultPosts = providedPosts ?? (await getBlogPosts(locale)).map(({ data }) => data);
const posts = defaultPosts.slice(0, 3);
---

{
  (posts.length > 0 || showWhenEmpty) && (
    <section id="blog" class="blog-preview section-padding" aria-labelledby="blog-preview-title">
      <div class="mx-auto max-w-6xl px-4 md:px-6">
        <div class="blog-preview__header">
          <span class="blog-preview__icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
              <path
                d="M12 20V6M12 6l-5.5 5.5M12 6l5.5 5.5"
                stroke="#fff"
                stroke-width="2.25"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </span>
          <p class="blog-preview__eyebrow">{labels.eyebrow}</p>
          <h2 class="blog-preview__title" id="blog-preview-title">{labels.title}</h2>
          <p class="blog-preview__subtitle">{labels.subtitle}</p>
        </div>

        <div class:list={['blog-preview__grid', { 'blog-preview__grid--single': posts.length === 1 }]}>
          {posts.map((post) => (
            <div class="blog-preview__card-wrap">
              <BlogCard post={post} locale={locale} eager />
            </div>
          ))}
        </div>

        <div class="mt-10 text-center">
          <a href={blogHref} class="blog-preview__link">{labels.allPosts}</a>
        </div>
      </div>
    </section>
  )
}

<style>
  .blog-preview {
    background: #fff;
    overflow-x: clip;
    max-width: 100%;
  }

  .blog-preview__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 2.5rem;
    text-align: center;
  }

  .blog-preview__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    margin-inline: auto;
    border-radius: 50%;
    background: linear-gradient(160deg, #651561 0%, #5a1c73 100%);
    box-shadow: 0 8px 20px rgba(101, 21, 97, 0.25);
  }

  .blog-preview__eyebrow {
    margin: 0.9rem 0 0;
    color: #c60691;
    font-size: 0.9375rem;
    font-weight: 800;
  }

  .blog-preview__title {
    margin: 0.5rem 0 0;
    font-size: 1.875rem;
    line-height: 1.25;
    font-weight: 900;
    color: #111827;
  }

  @media (min-width: 768px) {
    .blog-preview__title {
      font-size: 2.625rem;
    }
  }

  .blog-preview__subtitle {
    margin: 0.75rem auto 0;
    max-width: 36rem;
    font-size: 1.0625rem;
    line-height: 1.5;
    color: #4b5563;
  }

  @media (min-width: 768px) {
    .blog-preview__subtitle {
      font-size: 1.125rem;
    }
  }

  .blog-preview__grid {
    display: grid;
    gap: 1.25rem;
    justify-items: stretch;
    width: 100%;
    max-width: 100%;
    min-width: 0;
  }

  @media (min-width: 768px) {
    .blog-preview__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .blog-preview__grid--single {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    width: 100%;
  }

  .blog-preview__card-wrap {
    width: 100%;
    max-width: min(22.5rem, 100%);
    min-width: 0;
    margin-inline: auto;
    overflow: hidden;
  }

  .blog-preview__card-wrap :global(.blog-card) {
    width: 100%;
    height: auto;
  }

  @media (min-width: 768px) {
    .blog-preview__card-wrap {
      max-width: 26rem;
    }
  }

  .blog-preview__link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    padding: 0.75rem 2rem;
    border-radius: 9999px;
    background: #651561;
    color: #fff;
    font-weight: 800;
    font-size: 1rem;
    transition: background-color 0.2s ease;
  }

  .blog-preview__link:hover {
    background-color: #5a1c73;
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-preview__link {
      transition: none;
    }
  }
</style>
