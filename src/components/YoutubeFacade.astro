---
interface Props {
  youtubeId: string;
  title: string;
  /** portrait = vertical phone videos (testimonials); landscape = standard 16:9 */
  aspect?: 'portrait' | 'landscape';
}

const { youtubeId, title, aspect = 'landscape' } = Astro.props;
const isPortrait = aspect === 'portrait';
/*
  YouTube still serves landscape thumbs for vertical uploads (center strip + blurred sides).
  In a 9:16 frame, object-fit: cover crops those sides away.
*/
const thumb = `https://i.ytimg.com/vi/${youtubeId}/hq720.jpg`;
const thumbFallback = `https://i.ytimg.com/vi/${youtubeId}/hqdefault.jpg`;
---

<div
  class:list={['youtube-facade', isPortrait && 'youtube-facade--portrait']}
  data-aspect={aspect}
>
  <div class="youtube-facade__frame">
    <button
      type="button"
      class="youtube-facade__btn group"
      data-youtube-id={youtubeId}
      data-youtube-title={title}
      aria-label={`נגן — ${title}`}
    >
      <img
        src={thumb}
        alt=""
        loading="lazy"
        decoding="async"
        width={isPortrait ? 720 : 1280}
        height={isPortrait ? 1280 : 720}
        class="youtube-facade__thumb"
        onerror={`this.onerror=null;this.src='${thumbFallback}'`}
      />
      <span class="youtube-facade__play" aria-hidden="true">
        <svg width="68" height="48" viewBox="0 0 68 48" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path
            d="M66.52 7.74a8 8 0 0 0-5.63-5.66C55.3 1 34 1 34 1S12.7 1 7.11 2.08a8 8 0 0 0-5.63 5.66A83.2 83.2 0 0 0 0 24a83.2 83.2 0 0 0 1.48 16.26 8 8 0 0 0 5.63 5.66C12.7 47 34 47 34 47s21.3 0 26.89-1.08a8 8 0 0 0 5.63-5.66A83.2 83.2 0 0 0 68 24a83.2 83.2 0 0 0-1.48-16.26Z"
            fill="#212121"
            fill-opacity="0.8"></path>
          <path d="M45 24 27 14v20l18-10Z" fill="#fff"></path>
        </svg>
      </span>
    </button>
  </div>
</div>

<style>
  .youtube-facade {
    overflow: hidden;
    border-radius: 0.75rem;
    background: #000;
    box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
    width: 100%;
  }

  .youtube-facade__frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
    overflow: hidden;
  }

  .youtube-facade--portrait .youtube-facade__frame {
    aspect-ratio: 9 / 16;
  }

  .youtube-facade__btn {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    cursor: pointer;
    border: none;
    padding: 0;
    background: #000;
  }

  .youtube-facade__btn:focus-visible {
    outline: 2px solid #fcc000;
    outline-offset: 2px;
  }

  .youtube-facade__thumb {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    background: #000;
    transition: transform 0.3s ease;
  }

  /* Extra zoom on portrait so blurred YouTube sidebars never peek in */
  .youtube-facade--portrait .youtube-facade__thumb {
    object-fit: cover;
    /* Landscape YT thumb: video lives in the middle ~40% — scale just enough to crop blur */
    transform: scale(1.01);
  }

  .youtube-facade__btn:hover .youtube-facade__thumb {
    transform: scale(1.03);
  }

  .youtube-facade--portrait .youtube-facade__btn:hover .youtube-facade__thumb {
    transform: scale(1.04);
  }

  .youtube-facade__play {
    position: relative;
    z-index: 1;
    filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.35));
    transition: transform 0.2s ease;
  }

  .youtube-facade__btn:hover .youtube-facade__play {
    transform: scale(1.06);
  }

  .youtube-facade__frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .youtube-facade__thumb,
    .youtube-facade__play {
      transition: none;
    }

    .youtube-facade__btn:hover .youtube-facade__thumb,
    .youtube-facade--portrait .youtube-facade__thumb,
    .youtube-facade--portrait .youtube-facade__btn:hover .youtube-facade__thumb,
    .youtube-facade__btn:hover .youtube-facade__play {
      transform: none;
    }

    .youtube-facade--portrait .youtube-facade__thumb {
      transform: none;
    }
  }
</style>
