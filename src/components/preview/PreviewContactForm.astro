---
import CheckIcon from '../icons/CheckIcon.astro';
import Reveal from '../Reveal.astro';
import PremiumAtmosphere from './PremiumAtmosphere.astro';
import { homeCta, formPlaceholders, formLabels } from '../../data/site';
import type { Locale } from '../../i18n/config';
import type { UiStrings } from '../../i18n/he/ui';

interface Props {
  locale?: Locale;
  strings?: UiStrings['form'];
  thankYouUrl?: string;
  cta?: string;
  privacyHref?: string;
  copy?: {
    quote: string;
    quoteFooter: string;
    benefitsLabel: string;
    benefits: readonly string[];
    eyebrow: string;
    title: string;
  };
}

const {
  locale = 'he',
  strings = {
    name: formLabels.name,
    phone: formLabels.phone,
    email: 'מייל',
    vertical: formLabels.vertical,
    namePlaceholder: formPlaceholders.name,
    phonePlaceholder: formPlaceholders.phone,
    emailPlaceholder: 'מייל',
    verticalPlaceholder: formPlaceholders.vertical,
    submit: homeCta,
    sending: 'שולח…',
    nameError: 'נא להזין שם מלא',
    phoneError: 'נא להזין מספר טלפון תקין',
    verticalError: 'נא להזין את תחום העסק',
    privacyError: 'יש לאשר את מדיניות הפרטיות',
    genericError: 'שגיאה בשליחה. נסו שוב או כתבו ל-info@profitmedia.co.il',
    privacyPrefix: 'קראתי ואני מאשר/ת את ',
    privacyLink: 'מדיניות הפרטיות',
    privacySuffix: ', ומסכים/ה לשמירת המידע לצורך טיפול בפנייתי (חובה)',
  },
  thankYouUrl,
  cta = homeCta,
  privacyHref = '/prat',
  copy = {
    quote: '"כשמחברים את הפרסום לדף ול־CRM, רואים איפה ההשקעה באמת מייצרת פגישות ועסקאות."',
    quoteFooter: 'כך נראית מערכת שמודדת ערך, לא רק לידים',
    benefitsLabel: 'מה מקבלים',
    benefits: ['מיפוי ההשקעה מול פגישות ועסקאות', 'המלצות לחיבור המדידה והאופטימיזציה', 'מענה תוך 24 שעות'],
    eyebrow: 'ללא כל התחייבות',
    title: 'השאירו פרטים וקבלו אבחון קמפיין חינם',
  },
} = Astro.props;
---

<section id="contact" class="preview-contact-depth contact-section section-padding below-fold relative overflow-hidden">
  <PremiumAtmosphere variant="contact" />

  <div class="relative mx-auto max-w-6xl px-4 md:px-6">
    <Reveal>
      <div class="grid items-start gap-12 lg:grid-cols-2 lg:gap-16 xl:gap-20">
        <div class="order-2 flex flex-col justify-center text-start text-white max-lg:items-center max-lg:text-center lg:order-none lg:min-h-[28rem]">
          <blockquote class="mb-8 max-w-md text-lg font-bold leading-relaxed text-white/95 md:text-xl">
            {copy.quote}
            <footer class="mt-3 text-base font-semibold text-white/75">{copy.quoteFooter}</footer>
          </blockquote>

          <ul class="contact-benefits space-y-5 text-lg text-white/90 md:text-xl lg:space-y-6" aria-label={copy.benefitsLabel}>
            {copy.benefits.map((benefit) => (
              <li class="flex items-center justify-start gap-3.5 max-lg:justify-center">
                <span class="contact-check" aria-hidden="true"><CheckIcon /></span>
                <span>{benefit}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="contact-form-column order-1 w-full max-w-lg justify-self-center lg:order-none lg:max-w-none lg:justify-self-auto">
          <div class="contact-form-heading mb-8 w-full text-center text-white md:mb-10 lg:text-start">
            <p class="contact-form-eyebrow mb-3 font-semibold text-white/85" data-ab-bottom-eyebrow>{copy.eyebrow}</p>
            <h2 class="contact-form-title w-full font-black leading-tight" data-ab-bottom-title>
              {copy.title}
            </h2>
          </div>

          <form
            class="contact-form w-full"
            method="POST"
            action="#"
            id="preview-contact-form"
            data-locale={locale}
            data-thank-you={thankYouUrl}
            data-sending={strings.sending}
            data-name-error={strings.nameError}
            data-phone-error={strings.phoneError}
            data-vertical-error={strings.verticalError}
            data-privacy-error={strings.privacyError}
            data-generic-error={strings.genericError}
            data-submit-label={cta}
            novalidate
            autocomplete="off"
          >
            <div class="space-y-2.5 md:space-y-3.5">
              <div class="field-group">
                <label for="preview-name" class="preview-contact-label">{strings.name}</label>
                <input
                  type="text"
                  id="preview-name"
                  name="name"
                  required
                  autocomplete="name"
                  class="contact-input"
                  placeholder={strings.namePlaceholder}
                  aria-describedby="preview-name-error"
                />
                <p id="preview-name-error" class="field-error hidden" role="alert"></p>
              </div>

              <div class="field-group">
                <label for="preview-phone" class="preview-contact-label">{strings.phone}</label>
                <input
                  type="tel"
                  id="preview-phone"
                  name="phone"
                  required
                  inputmode="tel"
                  autocomplete="tel"
                  pattern="[0-9\-+() ]{9,15}"
                  class="contact-input"
                  placeholder={strings.phonePlaceholder}
                  aria-describedby="preview-phone-error"
                />
                <p id="preview-phone-error" class="field-error hidden" role="alert"></p>
              </div>

              <div class="field-group">
                <label for="preview-vertical" class="preview-contact-label">{strings.vertical}</label>
                <input
                  type="text"
                  id="preview-vertical"
                  name="vertical"
                  required
                  autocomplete="organization-title"
                  class="contact-input"
                  placeholder={strings.verticalPlaceholder}
                  aria-describedby="preview-vertical-error"
                />
                <p id="preview-vertical-error" class="field-error hidden" role="alert"></p>
              </div>
            </div>

            <label class="contact-privacy mt-5 flex cursor-pointer items-start gap-3">
              <input
                type="checkbox"
                id="preview-privacy"
                name="privacy"
                required
                class="contact-checkbox mt-0.5 shrink-0"
                aria-describedby="preview-privacy-error"
              />
              <span class="text-start text-sm leading-relaxed text-white/75">
                {strings.privacyPrefix}
                <a href={privacyHref} class="text-brand-yellow underline underline-offset-2 hover:text-white"
                  >{strings.privacyLink}</a>{strings.privacySuffix}
              </span>
            </label>
            <p id="preview-privacy-error" class="field-error mt-2 hidden text-start" role="alert"></p>

            <button type="submit" id="preview-contact-submit" class="btn-yellow contact-submit mt-6 w-full rounded-full">
              <span id="preview-contact-submit-label" data-ab-bottom-submit>{cta}</span>
            </button>

            <p
              id="preview-form-status"
              class="form-success mt-4 hidden text-center text-sm font-semibold"
              role="status"
              aria-live="polite"
            ></p>
          </form>
        </div>
      </div>
    </Reveal>
  </div>
</section>

<script>
  function getPageAb() {
    return window.pmAdsAb || window.pmHomeAb;
  }
  function getLeadPageMeta() {
    const pageRoot = document.querySelector('[data-lead-page]') as HTMLElement | null;
    return {
      formSource: pageRoot?.dataset.leadSource || 'homepage-contact-form',
      thankYou: form?.dataset.thankYou || pageRoot?.dataset.thankYou || '/thank-you',
    };
  }

  const form = document.getElementById('preview-contact-form') as HTMLFormElement | null;
  const status = document.getElementById('preview-form-status');
  const submitBtn = document.getElementById('preview-contact-submit') as HTMLButtonElement | null;
  const submitLabel = document.getElementById('preview-contact-submit-label');

  const fields = {
    name: {
      input: document.getElementById('preview-name') as HTMLInputElement | null,
      error: document.getElementById('preview-name-error'),
      message: form?.dataset.nameError || '',
    },
    phone: {
      input: document.getElementById('preview-phone') as HTMLInputElement | null,
      error: document.getElementById('preview-phone-error'),
      message: form?.dataset.phoneError || '',
    },
    vertical: {
      input: document.getElementById('preview-vertical') as HTMLInputElement | null,
      error: document.getElementById('preview-vertical-error'),
      message: form?.dataset.verticalError || '',
    },
    privacy: {
      input: document.getElementById('preview-privacy') as HTMLInputElement | null,
      error: document.getElementById('preview-privacy-error'),
      message: form?.dataset.privacyError || '',
    },
  };

  const setFieldError = (key: keyof typeof fields, show: boolean) => {
    const field = fields[key];
    if (!field.input || !field.error) return;
    field.input.classList.toggle('contact-input--error', show);
    field.input.setAttribute('aria-invalid', show ? 'true' : 'false');
    field.error.textContent = show ? field.message : '';
    field.error.classList.toggle('hidden', !show);
  };

  const validate = () => {
    let valid = true;
    if (!fields.name.input?.value.trim()) {
      setFieldError('name', true);
      valid = false;
    } else setFieldError('name', false);

    const phone = fields.phone.input?.value.trim() ?? '';
    if (!phone || !/^[0-9\-+() ]{9,15}$/.test(phone)) {
      setFieldError('phone', true);
      valid = false;
    } else setFieldError('phone', false);

    if (!fields.vertical.input?.value.trim()) {
      setFieldError('vertical', true);
      valid = false;
    } else setFieldError('vertical', false);

    if (!fields.privacy.input?.checked) {
      setFieldError('privacy', true);
      valid = false;
    } else setFieldError('privacy', false);

    return valid;
  };

  Object.values(fields).forEach((field) => {
    field.input?.addEventListener('blur', validate);
    field.input?.addEventListener('input', () => {
      if (field.input?.getAttribute('aria-invalid') === 'true') validate();
    });
    field.input?.addEventListener('change', () => {
      if (field.input?.getAttribute('aria-invalid') === 'true') validate();
    });
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    status?.classList.add('hidden');
    if (!validate()) {
      const firstInvalid = form.querySelector<HTMLElement>('[aria-invalid="true"]');
      firstInvalid?.focus();
      return;
    }

    if (submitBtn) submitBtn.disabled = true;
    if (submitLabel) submitLabel.textContent = form.dataset.sending || '';

    const meta = getLeadPageMeta();
    const thankYou = meta.thankYou;
    const ab = getPageAb();
    const attr =
      typeof window.pmGetLeadAttribution === 'function'
        ? window.pmGetLeadAttribution()
        : { utm: {}, landingUrl: window.location.href };
    const payload = {
      name: fields.name.input?.value.trim(),
      phone: fields.phone.input?.value.trim(),
      email: '',
      vertical: fields.vertical.input?.value.trim() || '',
      verticalLabel: fields.vertical.input?.value.trim() || '',
      pageUrl: window.location.href,
      landingUrl: attr.landingUrl,
      utm: attr.utm,
      source: meta.formSource,
      formType: 'inline_form',
      ctaLabel:
        (typeof ab?.getCtaLabel === 'function' && ab.getCtaLabel('simple')) ||
        (submitLabel?.textContent || submitBtn?.textContent || '').replace(/\s+/g, ' ').trim().slice(0, 160) ||
        '',
      referrer: document.referrer || '',
      language: navigator.language,
      locale: form.dataset.locale || 'he',
      device: typeof window.pmDeviceClass === 'function' ? window.pmDeviceClass() : 'Desk',
    };

    try {
      ab?.setLeadSource?.('simple');
      await ab?.trackConversion?.('simple');
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = (await res.json()) as { ok?: boolean };
      if (!res.ok || !data.ok) throw new Error('submit failed');
      window.location.href = thankYou;
    } catch {
      if (status) {
        status.textContent = form.dataset.genericError || '';
        status.classList.remove('hidden');
        status.setAttribute('role', 'alert');
      }
    } finally {
      if (submitBtn) submitBtn.disabled = false;
      if (submitLabel && ab) {
        const id = ab.getAssignments().bottom_copy;
        const copy = ab.findVariant('bottom_copy', id);
        submitLabel.textContent = copy?.submitLabel || form.dataset.submitLabel || '';
      } else if (submitLabel) {
        submitLabel.textContent = form.dataset.submitLabel || '';
      }
    }
  });
</script>

<style>
  .contact-form-title {
    font-size: clamp(1.25rem, 4.2vw, 2.625rem);
  }

  .contact-form-column {
    margin-inline: auto;
    width: 100%;
  }

  @media (max-width: 1023px) {
    .contact-form-column {
      justify-self: center;
      margin-inline: auto;
      max-width: min(32rem, 100%);
    }

    .contact-form-heading,
    .contact-form-heading .contact-form-title,
    .contact-form-heading .contact-form-eyebrow {
      text-align: center;
    }
  }

  @media (min-width: 1024px) {
    .contact-form-column {
      margin-inline: 0;
    }
  }

  @media (max-width: 767px) {
    .contact-form-heading {
      margin-bottom: 1.25rem;
      text-align: center;
    }

    .preview-contact-label {
      font-size: 0.875rem;
      margin-bottom: 0.25rem;
    }
  }
</style>
