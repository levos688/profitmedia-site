---
import HeroIllustration from '../HeroIllustration.astro';
import PremiumAtmosphere from './PremiumAtmosphere.astro';
import { hero as defaultHero } from '../../data/site';
import type { HomeContent } from '../../i18n/he/home';

interface Props {
  overrideTitle?: string;
  content?: HomeContent['hero'];
  illustrationAlt?: string;
}

const {
  overrideTitle,
  content = defaultHero,
  illustrationAlt = 'פרסום דיגיטלי — איור',
} = Astro.props;
const hero = content;
const displayTitle = overrideTitle || hero.title;
---

<section
  class="preview-depth-section hero-gradient relative overflow-hidden pb-4 pt-4 md:pb-8 md:pt-6"
  aria-labelledby="hero-title"
  data-ab-hero
>
  <div class="hero-gradient__mesh" aria-hidden="true"></div>
  <PremiumAtmosphere variant="hero" />

  <div class="relative mx-auto max-w-6xl px-4 md:px-6">
    <div class="hero-layout py-6 md:py-10">
      <p
        class="hero-eyebrow text-sm font-bold tracking-wide text-white/90 md:text-base"
        data-ab-hero-eyebrow
      >
        {hero.eyebrow}
      </p>

      <h1
        id="hero-title"
        class="hero-title mt-3 text-4xl leading-tight font-bold text-white md:mt-4 md:text-[52px] lg:text-[56px]"
        data-ab-hero-title
      >
        {
          displayTitle.split('\n').map((line, index) => (
            <>
              {index > 0 && <br />}
              <span class="hero-title__line">{line}</span>
            </>
          ))
        }
      </h1>

      <div class="hero-visual">
        <HeroIllustration alt={illustrationAlt} />
      </div>

      <div class="hero-more text-white">
        <p class="hero-subtitle text-lg leading-relaxed text-white/95 md:text-2xl" data-ab-hero-subtitle>
          {hero.subtitle}
        </p>

        {
          hero.proofChip && (
            <p class="hero-proof-chip" data-ab-hero-proof>
              {hero.proofChip}
            </p>
          )
        }

        {
          hero.trustLine && (
            <p class="hero-trust-line" data-ab-hero-trust>
              {hero.trustLine}
            </p>
          )
        }

        <div class="hero-cta-wrap">
          <button
            type="button"
            class="btn-yellow rounded-full font-black hero-cta"
            data-lead-modal-open
            data-ab-open="hero"
            data-cta="hero_cta"
            data-ab-hero-cta
          >
            {hero.cta}
          </button>
          {
            hero.ctaNote && (
              <p class="hero-cta-note" data-ab-hero-note>
                {hero.ctaNote}
              </p>
            )
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-layout {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0;
  }

  .hero-eyebrow {
    letter-spacing: 0.02em;
    width: 100%;
  }

  .hero-title {
    width: 100%;
    max-width: 52rem;
    text-wrap: balance;
    min-width: 0;
  }

  .hero-title__line {
    white-space: nowrap;
  }

  @media (max-width: 479px) {
    .hero-title__line {
      white-space: normal;
    }
  }

  .hero-visual {
    display: flex;
    justify-content: center;
    width: 100%;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .hero-more {
    width: 100%;
    max-width: 36rem;
    margin-top: 0.5rem;
  }

  .hero-subtitle {
    margin: 0;
  }

  .hero-trust-line {
    margin-top: 1.25rem;
    font-size: 1.05rem; /* Increased size as requested */
    font-weight: 600;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.82);
  }

  .hero-cta-wrap {
    margin-top: 1.75rem; /* More balanced top margin */
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .hero-cta {
    min-height: 44px;
    padding: 0.75rem 1.75rem;
    font-size: 1.05rem;
  }

  .hero-cta-note {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.78);
  }

  /* Desktop RTL: first column = inline-start = right → copy; second = left → image */
  @media (min-width: 1024px) {
    .hero-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(22rem, 1fr);
      grid-template-areas:
        'eyebrow visual'
        'title visual'
        'more visual';
      column-gap: 3.5rem;
      row-gap: 0.75rem;
      align-items: center;
      text-align: start;
    }

    .hero-eyebrow {
      grid-area: eyebrow;
      align-self: end;
    }

    .hero-title {
      grid-area: title;
      max-width: none;
      margin-top: 0;
    }

    .hero-visual {
      grid-area: visual;
      margin: 0;
      justify-content: center;
      width: 100%;
      min-width: 0;
    }

    .hero-more {
      grid-area: more;
      max-width: none;
      margin-top: -0.5rem;
      justify-self: stretch;
    }

    .hero-cta-wrap {
      align-items: flex-start;
    }

    .hero-proof-chip {
      margin-inline: 0;
    }

    .hero-eyebrow,
    .hero-title,
    .hero-more {
      animation: hero-fade-up 0.85s cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .hero-visual {
      animation: hero-fade-up 0.85s cubic-bezier(0.22, 1, 0.36, 1) 0.12s both;
    }
  }

  @keyframes hero-fade-up {
    from {
      transform: translateY(24px);
      opacity: 0.01;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-eyebrow,
    .hero-title,
    .hero-more,
    .hero-visual {
      animation: none;
    }
  }
</style>
