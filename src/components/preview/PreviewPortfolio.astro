---
import SectionTitle from '../SectionTitle.astro';
import HorizontalCarousel from '../HorizontalCarousel.astro';
import Reveal from '../Reveal.astro';
import OptimizedImage from '../OptimizedImage.astro';
import { getPortfolioLandings } from '../../data/site';
import type { HomeContent } from '../../i18n/he/home';
import type { UiStrings } from '../../i18n/he/ui';

interface Props {
  landings?: HomeContent['landings'];
  labels?: UiStrings['portfolio'];
  carouselLabel?: string;
  nextLabel?: string;
  previousLabel?: string;
}

const {
  landings = getPortfolioLandings(),
  labels = {
    title: 'דפי נחיתה ממירים במיוחד',
    subtitle: 'מבחר דפי נחיתה שבנינו לקמפיינים בתחומים שונים',
    enlarge: (title: string) => `הגדל — ${title}`,
    close: 'סגור',
    previous: 'דף נחיתה קודם',
    next: 'דף נחיתה הבא',
  },
  carouselLabel = 'גלריית דפי נחיתה',
  nextLabel = 'גלול קדימה',
  previousLabel = 'גלול אחורה',
} = Astro.props;
const portfolioLandings = landings;
const slidesJson = JSON.stringify(
  portfolioLandings.map((item) => ({ image: item.image, title: item.title }))
);
---

<section id="portfolio" class="section-padding below-fold bg-white">
  <div class="mx-auto max-w-6xl px-4 md:px-6">
    <Reveal>
      <SectionTitle
        title={labels.title}
        subtitle={labels.subtitle}
        class="mb-10 md:mb-14"
      />
    </Reveal>

    <Reveal delay={100}>
      <HorizontalCarousel
        ariaLabel={carouselLabel}
        nextLabel={nextLabel}
        previousLabel={previousLabel}
        shuffle
        loop
      >
        {
          portfolioLandings.map((item, i) => (
            <article class="carousel-item landing-card">
              <button
                type="button"
                class="landing-card__btn"
                data-lightbox-trigger
                data-lightbox-index={String(i)}
                data-image={item.image}
                data-title={item.title}
                aria-label={labels.enlarge(item.title)}
              >
                <div class="landing-card__frame">
                  <OptimizedImage src={item.image} alt={item.title} width={700} height={1050} />
                </div>
                <p class="landing-card__caption">{item.title}</p>
              </button>
            </article>
          ))
        }
      </HorizontalCarousel>
    </Reveal>
  </div>
</section>

{/* Lightbox must NOT sit inside .below-fold. content-visibility:auto applies
    contain:paint, which becomes the containing block for position:fixed.
    On iOS that combination freezes the page after opening a gallery image. */}
<div
  id="landing-lightbox"
  class="lightbox"
  role="dialog"
  aria-modal="true"
  aria-labelledby="lightbox-title"
  hidden
>
  <div class="lightbox__backdrop" data-lightbox-close tabindex="-1"></div>
  <div class="lightbox__panel">
    <button type="button" class="lightbox__close" data-lightbox-close aria-label={labels.close}>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
      </svg>
    </button>

    <div class="lightbox__stage" dir="ltr">
      <button type="button" class="lightbox__nav lightbox__nav--prev" data-lightbox-prev aria-label={labels.previous}>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>

      <div class="lightbox__media" data-lightbox-media>
        <img
          id="lightbox-image"
          class="lightbox__image"
          src=""
          alt=""
          draggable="false"
        />
      </div>

      <button type="button" class="lightbox__nav lightbox__nav--next" data-lightbox-next aria-label={labels.next}>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>
    </div>

    <p id="lightbox-title" class="lightbox__title"></p>
  </div>
</div>

<script type="application/json" id="portfolio-slides" is:inline set:html={slidesJson}></script>

<script is:inline>
  (() => {
    const portfolio = document.getElementById('portfolio');
    const lightbox = document.getElementById('landing-lightbox');
    const lightboxImage = document.getElementById('lightbox-image');
    const lightboxTitle = document.getElementById('lightbox-title');
    const media = lightbox && lightbox.querySelector('[data-lightbox-media]');
    if (!portfolio || !lightbox || !lightboxImage || !lightboxTitle || !media) return;

    // Park the overlay on <html>, not <body>. body has overflow-x:clip and
    // position:relative; in iOS Safari that contains position:fixed and freezes
    // the page after a gallery image opens.
    if (lightbox.parentElement !== document.documentElement) {
      document.documentElement.appendChild(lightbox);
    }

    let slides = [];
    let currentIndex = 0;
    let isOpen = false;
    let lockY = 0;
    let preventMove = null;
    let hideTimer = 0;
    let swallowUntil = 0;
    let scale = 1;
    let panX = 0;
    let panY = 0;
    let startScale = 1;
    let startPanX = 0;
    let startPanY = 0;
    let pinchStartDist = 0;
    let gestureX = 0;
    let gestureY = 0;
    let didPinch = false;
    let didPan = false;
    let lastTapAt = 0;
    let overlayX = 0;
    let overlayY = 0;
    let skipBackdropClickUntil = 0;
    let lastPageTapAt = 0;
    let lastFocus = null;
    let viewportMeta = document.querySelector('meta[name="viewport"]');
    let viewportOrig = viewportMeta ? viewportMeta.getAttribute('content') || '' : '';

    const dist = (a, b) => {
      const dx = a.clientX - b.clientX;
      const dy = a.clientY - b.clientY;
      return Math.sqrt(dx * dx + dy * dy);
    };

    const applyZoom = () => {
      lightboxImage.style.transform =
        'translate3d(' + panX + 'px,' + panY + 'px,0) scale(' + scale + ')';
    };

    const resetZoom = () => {
      scale = 1;
      panX = 0;
      panY = 0;
      applyZoom();
    };

    const syncSlidesFromDom = () => {
      const buttons = portfolio.querySelectorAll(
        '.carousel-item:not([data-carousel-clone]) [data-lightbox-trigger]'
      );
      slides = Array.prototype.map.call(buttons, (btn) => ({
        image: btn.getAttribute('data-image') || '',
        title: btn.getAttribute('data-title') || '',
      }));
    };

    const showSlide = (index) => {
      syncSlidesFromDom();
      if (!slides.length) return;
      currentIndex = ((index % slides.length) + slides.length) % slides.length;
      const item = slides[currentIndex];
      resetZoom();
      lightboxImage.src = item.image;
      lightboxImage.alt = item.title;
      lightboxTitle.textContent = item.title;
    };

    const restoreScroll = () => {
      const y = lockY || 0;
      window.scrollTo(0, y);
      document.documentElement.scrollTop = y;
      document.body.scrollTop = y;
    };

    // Lock background scroll without overflow:hidden/clip on <html> — that
    // would contain this position:fixed overlay and freeze iOS again.
    const lockPage = () => {
      lockY = window.scrollY || window.pageYOffset || 0;
      document.documentElement.classList.add('lightbox-open');
      document.documentElement.style.overflow = 'visible';
      document.documentElement.style.touchAction = 'none';
      document.body.style.position = 'fixed';
      document.body.style.top = '-' + lockY + 'px';
      document.body.style.left = '0';
      document.body.style.right = '0';
      document.body.style.width = '100%';
      document.body.style.overflow = 'visible';
      document.body.style.touchAction = 'none';
      // Stop iOS from pinch/double-tap zooming the whole page while the
      // overlay is open. Restore the original viewport on close.
      if (viewportMeta) {
        viewportOrig = viewportMeta.getAttribute('content') || viewportOrig;
        viewportMeta.setAttribute(
          'content',
          'width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no'
        );
      }
      if (!preventMove) {
        preventMove = (e) => {
          if (!isOpen) return;
          if (e.touches && e.touches.length > 1) return;
          const t = e.target;
          if (t && lightbox.contains(t)) return;
          e.preventDefault();
        };
        document.addEventListener('touchmove', preventMove, { passive: false });
      }
    };

    const unlockPage = () => {
      document.documentElement.classList.remove('lightbox-open');
      document.documentElement.style.overflow = '';
      document.documentElement.style.touchAction = '';
      document.body.style.position = '';
      document.body.style.top = '';
      document.body.style.left = '';
      document.body.style.right = '';
      document.body.style.width = '';
      document.body.style.overflow = '';
      document.body.style.touchAction = '';
      if (viewportMeta) {
        viewportMeta.setAttribute(
          'content',
          viewportOrig || 'width=device-width, initial-scale=1'
        );
      }
      if (preventMove) {
        document.removeEventListener('touchmove', preventMove);
        preventMove = null;
      }
      restoreScroll();
      window.requestAnimationFrame(restoreScroll);
    };

    const openLightbox = (index) => {
      showSlide(index);
      if (!slides.length) return;
      if (hideTimer) {
        window.clearTimeout(hideTimer);
        hideTimer = 0;
      }
      lastFocus = document.activeElement instanceof HTMLElement ? document.activeElement : lastFocus;
      isOpen = true;
      lightbox.hidden = false;
      lightbox.classList.remove('is-closing');
      lightbox.style.pointerEvents = '';
      lockPage();
      const closeBtn = lightbox.querySelector('.lightbox__close');
      if (closeBtn) closeBtn.focus();
      document.dispatchEvent(new CustomEvent('pm:lightbox', { detail: 'open' }));
    };

    const closeLightbox = () => {
      if (!isOpen) {
        restoreScroll();
        return;
      }
      isOpen = false;
      resetZoom();
      // Keep the overlay in the DOM for a beat. Hiding it immediately lets iOS
      // retarget the same touch onto the carousel → the strip scrolls away.
      lightbox.classList.add('is-closing');
      lightbox.style.pointerEvents = 'none';
      swallowUntil = Date.now() + 450;
      document.dispatchEvent(new CustomEvent('pm:lightbox', { detail: 'close' }));
      unlockPage();
      if (hideTimer) window.clearTimeout(hideTimer);
      hideTimer = window.setTimeout(() => {
        lightbox.hidden = true;
        lightbox.classList.remove('is-closing');
        lightbox.style.pointerEvents = '';
        lightboxImage.removeAttribute('src');
        lightboxImage.src = '';
        restoreScroll();
        hideTimer = 0;
        if (lastFocus && typeof lastFocus.focus === 'function') {
          try { lastFocus.focus(); } catch (err) {}
        }
      }, 400);
    };

    const step = (delta) => {
      if (!isOpen) return;
      showSlide(currentIndex + delta);
    };

    portfolio.addEventListener('click', (e) => {
      const target = e.target;
      if (!(target instanceof Element)) return;
      if (target.closest('.carousel-arrow')) return;
      const btn = target.closest('[data-lightbox-trigger]');
      if (!btn || !portfolio.contains(btn)) return;
      if (btn.closest('[data-carousel-clone]')) return;
      e.preventDefault();
      e.stopPropagation();
      syncSlidesFromDom();
      const image = btn.getAttribute('data-image') || '';
      let index = slides.findIndex((s) => s.image === image);
      if (index < 0) index = 0;
      window.requestAnimationFrame(() => openLightbox(index));
    });

    lightbox.querySelectorAll('[data-lightbox-close]').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        if (Date.now() < skipBackdropClickUntil && el.hasAttribute('data-lightbox-close') && !el.classList.contains('lightbox__close')) {
          return;
        }
        closeLightbox();
      });
    });

    const prevBtn = lightbox.querySelector('[data-lightbox-prev]');
    const nextBtn = lightbox.querySelector('[data-lightbox-next]');
    if (prevBtn) {
      prevBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        step(-1);
      });
    }
    if (nextBtn) {
      nextBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        step(1);
      });
    }

    media.addEventListener(
      'touchstart',
      (e) => {
        if (!isOpen) return;
        const t0 = e.touches[0];
        if (!t0) return;
        gestureX = t0.clientX;
        gestureY = t0.clientY;
        startPanX = panX;
        startPanY = panY;
        didPinch = e.touches.length >= 2;
        didPan = false;
        if (e.touches.length >= 2) {
          pinchStartDist = dist(e.touches[0], e.touches[1]) || 1;
          startScale = scale;
        }
        e.preventDefault();
      },
      { passive: false }
    );

    media.addEventListener(
      'touchmove',
      (e) => {
        if (!isOpen) return;
        e.preventDefault();
        if (e.touches.length >= 2) {
          didPinch = true;
          const d = dist(e.touches[0], e.touches[1]) || 1;
          scale = Math.min(4, Math.max(1, startScale * (d / pinchStartDist)));
          if (scale <= 1.02) {
            scale = 1;
            panX = 0;
            panY = 0;
          }
          applyZoom();
          return;
        }
        if (scale > 1.02 && e.touches[0]) {
          didPan = true;
          panX = startPanX + (e.touches[0].clientX - gestureX);
          panY = startPanY + (e.touches[0].clientY - gestureY);
          applyZoom();
        }
      },
      { passive: false }
    );

    media.addEventListener(
      'touchend',
      (e) => {
        if (!isOpen) return;
        e.preventDefault();
        if (didPinch) {
          if (scale <= 1.02) resetZoom();
          didPinch = e.touches.length >= 2;
          return;
        }
        if (didPan) {
          if (scale <= 1.02) resetZoom();
          return;
        }
        const t = e.changedTouches[0];
        if (!t) return;
        const dx = t.clientX - gestureX;
        const dy = t.clientY - gestureY;
        if (scale <= 1.02 && Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) {
          step(dx < 0 ? 1 : -1);
          return;
        }
        if (Math.abs(dx) < 12 && Math.abs(dy) < 12) {
          const now = Date.now();
          if (now - lastTapAt < 300) {
            lastTapAt = 0;
            if (scale > 1.02) resetZoom();
            else {
              scale = 2.2;
              applyZoom();
            }
          } else {
            lastTapAt = now;
          }
        }
      },
      { passive: false }
    );

    lightbox.addEventListener(
      'touchstart',
      (e) => {
        const t = e.changedTouches[0];
        if (!t) return;
        overlayX = t.clientX;
        overlayY = t.clientY;
      },
      { passive: true }
    );

    lightbox.addEventListener(
      'touchend',
      (e) => {
        if (!isOpen) return;
        const target = e.target;
        if (!(target instanceof Element)) return;
        if (target.closest('[data-lightbox-media]')) return;
        if (target.closest('.lightbox__nav') || target.closest('.lightbox__close')) return;
        const t = e.changedTouches[0];
        if (!t) return;
        const dx = t.clientX - overlayX;
        const dy = t.clientY - overlayY;
        if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) {
          skipBackdropClickUntil = Date.now() + 400;
          step(dx < 0 ? 1 : -1);
          return;
        }
        if (target.closest('[data-lightbox-close]') && Math.abs(dx) < 40 && Math.abs(dy) < 40) {
          closeLightbox();
        }
      },
      { passive: true }
    );

    document.addEventListener(
      'click',
      (e) => {
        if (Date.now() >= swallowUntil) return;
        e.preventDefault();
        e.stopPropagation();
      },
      true
    );

    const blockPageZoom = (e) => {
      if (!isOpen) return;
      e.preventDefault();
    };
    document.addEventListener('gesturestart', blockPageZoom, { passive: false });
    document.addEventListener('gesturechange', blockPageZoom, { passive: false });
    document.addEventListener(
      'touchend',
      (e) => {
        if (!isOpen) return;
        const now = Date.now();
        if (now - lastPageTapAt < 350) e.preventDefault();
        lastPageTapAt = now;
      },
      { capture: true, passive: false }
    );

    document.addEventListener('keydown', (e) => {
      if (!isOpen) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') step(-1);
      if (e.key === 'ArrowRight') step(1);
    });

    window.addEventListener('pagehide', () => {
      if (isOpen) closeLightbox();
      else restoreScroll();
    });
    window.addEventListener('pageshow', () => {
      if (!isOpen) restoreScroll();
    });
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible' && !isOpen) restoreScroll();
    });
  })();
</script>

<style is:global>
  /* Overlay lives on <html>. html/body overflow:hidden|clip would contain
     position:fixed and freeze iOS Safari after opening a gallery image. */
  html.lightbox-open {
    overflow: visible !important;
    overflow-x: visible !important;
    touch-action: none;
  }

  html.lightbox-open .below-fold {
    content-visibility: visible;
    contain: none;
  }

  html.lightbox-open body {
    overflow: visible;
    overscroll-behavior: none;
    touch-action: none;
  }
</style>

<style>
  .landing-card {
    width: min(calc(100% - 0.5rem), 260px);
  }

  @media (min-width: 768px) {
    .landing-card {
      width: calc((min(100vw, 72rem) - 8rem) / 3);
      max-width: 340px;
    }
  }

  .landing-card__btn {
    display: block;
    width: 100%;
    cursor: zoom-in;
    text-align: center;
    background: none;
    border: none;
    padding: 0;
    -webkit-tap-highlight-color: transparent;
    position: relative;
    z-index: 1;
  }

  .landing-card__frame {
    aspect-ratio: 2 / 3;
    border-radius: 4px;
    border: 1px solid #e5e5e5;
    background: #fff;
    overflow: hidden;
    box-shadow: 0 4px 16px rgb(0 0 0 / 0.1);
    transition:
      box-shadow 0.2s,
      transform 0.2s;
  }

  .landing-card__btn:hover .landing-card__frame {
    box-shadow: 0 8px 24px rgb(101 21 97 / 0.18);
    transform: translateY(-2px);
  }

  .landing-card__frame :global(img),
  .landing-card__frame :global(picture) {
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
  }

  .landing-card__frame :global(img) {
    object-fit: cover;
    object-position: top center;
  }

  .landing-card__caption {
    margin-top: 0.625rem;
    padding-inline: 0.25rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: #1f2937;
    line-height: 1.4;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 2000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    overscroll-behavior: contain;
    touch-action: none;
  }

  .lightbox[hidden] {
    display: none !important;
  }

  .lightbox.is-closing {
    opacity: 0;
    /* Stay in the layer so iOS cannot retarget the closing tap onto the carousel. */
  }

  .lightbox__backdrop {
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 0.82);
    cursor: pointer;
  }

  .lightbox__panel {
    position: relative;
    z-index: 1;
    width: min(100%, 40rem);
    max-height: 92vh;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .lightbox__close {
    position: absolute;
    top: -2.75rem;
    inset-inline-end: 0;
    width: 2.75rem;
    height: 2.75rem;
    min-width: 44px;
    min-height: 44px;
    border-radius: 50%;
    border: none;
    background: #fff;
    color: #651561;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }

  @media (max-width: 767px) {
    .lightbox {
      padding: 3.5rem 0.35rem 1rem;
    }

    /* Keep close inside the visual viewport — top:-2.75rem was off-screen on phones. */
    .lightbox__close {
      position: fixed;
      top: max(0.75rem, env(safe-area-inset-top, 0px));
      right: 0.75rem;
      left: auto;
      inset-inline-end: 0.75rem;
    }

    .lightbox__stage {
      position: relative;
      gap: 0;
    }

    .lightbox__media {
      max-width: 100%;
    }

    .lightbox__nav {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      width: 44px;
      height: 44px;
      min-width: 44px;
      min-height: 44px;
      background: transparent;
      box-shadow: none;
      z-index: 3;
    }

    .lightbox__nav--prev {
      left: 0;
    }

    .lightbox__nav--next {
      right: 0;
    }

    .lightbox__nav svg {
      width: 14px;
      height: 14px;
      padding: 7px;
      border-radius: 50%;
      background: rgb(255 255 255 / 0.82);
      box-shadow: 0 2px 8px rgb(0 0 0 / 0.22);
    }
  }

  /* Arrows sit beside the image — never overlaid on top of it.
     dir=ltr on the stage keeps physical order: [‹] image [›] (outward),
     even though the page is RTL (otherwise flex reverses and chevrons point inward). */
  .lightbox__stage {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    width: 100%;
    max-width: 100%;
    direction: ltr;
  }

  .lightbox__media {
    flex: 1 1 auto;
    min-width: 0;
    max-width: calc(100% - 6.5rem);
    display: flex;
    justify-content: center;
    overflow: hidden;
    touch-action: none;
  }

  .lightbox__nav {
    position: static;
    flex: 0 0 auto;
    width: 2.75rem;
    height: 2.75rem;
    min-width: 44px;
    min-height: 44px;
    border-radius: 50%;
    border: none;
    background: rgb(255 255 255 / 0.95);
    color: #651561;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 16px rgb(0 0 0 / 0.25);
    z-index: 2;
    -webkit-tap-highlight-color: transparent;
  }

  .lightbox__nav:focus-visible,
  .lightbox__close:focus-visible {
    outline: 2px solid #fcc000;
    outline-offset: 2px;
  }

  .lightbox__image {
    max-width: 100%;
    max-height: calc(92vh - 5rem);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 4px;
    box-shadow: 0 12px 40px rgb(0 0 0 / 0.4);
    transform-origin: center center;
    touch-action: none;
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    user-select: none;
    -webkit-user-drag: none;
  }

  .lightbox__title {
    margin-top: 1rem;
