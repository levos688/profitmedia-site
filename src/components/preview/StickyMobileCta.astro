---
interface Props {
  label?: string;
  ariaLabel?: string;
  opensLeadModal?: boolean;
}

const {
  label = 'קבלו אבחון קמפיין חינם',
  ariaLabel = 'קריאה לפעולה',
  opensLeadModal = false,
} = Astro.props;
---

<div class="sticky-cta" aria-label={ariaLabel}>
  <button
    type="button"
    class="btn-yellow sticky-cta__btn"
    data-ab-sticky-label
    data-cta="sticky"
    data-lead-modal-open={opensLeadModal || undefined}
  >
    {label}
  </button>
</div>
