---
import SectionTitle from './SectionTitle.astro';
import HorizontalCarousel from './HorizontalCarousel.astro';
import Reveal from './Reveal.astro';
import { clientLogos as defaultClientLogos } from '../data/site';
import type { HomeContent } from '../i18n/he/home';

interface Props {
  logos?: HomeContent['clientLogos'];
  title?: string;
  ariaLabel?: string;
  nextLabel?: string;
  previousLabel?: string;
}

const {
  logos = defaultClientLogos,
  title = 'לקוחות',
  ariaLabel = 'לוגואים של לקוחות',
  nextLabel = 'גלול קדימה',
  previousLabel = 'גלול אחורה',
} = Astro.props;

const MANIFEST_URL = 'https://crm.profitmedia.co.il/cdn/clients/manifest.json';
---

<section id="clients" class="section-padding below-fold bg-white" data-client-logos data-manifest-url={MANIFEST_URL}>
  <div class="mx-auto max-w-6xl px-4 md:px-6">
    <Reveal>
      <SectionTitle title={title} class="mb-10 md:mb-16" />
    </Reveal>

    <Reveal delay={100}>
      <HorizontalCarousel ariaLabel={ariaLabel} nextLabel={nextLabel} previousLabel={previousLabel} motion="fade">
      {
        logos.map((logo) => (
          <div class="carousel-item client-logo">
            <img src={logo.src} alt={logo.alt} width="176" height="88" loading="lazy" decoding="async" />
          </div>
        ))
      }
    </HorizontalCarousel>
    </Reveal>
  </div>
</section>

<script>
  (() => {
    const section = document.querySelector('[data-client-logos]');
    if (!(section instanceof HTMLElement)) return;
    const manifestUrl = section.dataset.manifestUrl;
    if (!manifestUrl) return;

    let started = false;
    const load = async () => {
      if (started) return;
      started = true;
      try {
        const res = await fetch(manifestUrl, { credentials: 'omit' });
        if (!res.ok) return;
        const data = await res.json();
        const logos = Array.isArray(data?.logos) ? data.logos : [];
        if (!logos.length) return;

        const strip = section.querySelector('[data-carousel-strip]');
        const root = section.querySelector('[data-carousel-root]');
        if (!(strip instanceof HTMLElement) || !(root instanceof HTMLElement)) return;

        strip.querySelectorAll(':scope > .carousel-item').forEach((el) => el.remove());
        for (const logo of logos) {
          if (!logo?.src) continue;
          const item = document.createElement('div');
          item.className = 'carousel-item client-logo';
          const img = document.createElement('img');
          img.src = String(logo.src);
          img.alt = String(logo.alt || '');
          // HTML attrs keep display size even if CSS is delayed/cached oddly.
          img.width = 176;
          img.height = 88;
          img.loading = 'lazy';
          img.decoding = 'async';
          item.appendChild(img);
          strip.appendChild(item);
        }
        // If the carousel already booted with static fallbacks, rebuild its
        // clones and index. Otherwise its first boot will use these CRM items.
        if (root.hasAttribute('data-carousel-ready')) {
          root.dispatchEvent(new CustomEvent('pm:carousel-reload'));
        }
      } catch {
        // Keep SSR static fallback.
      }
    };

    if (!('IntersectionObserver' in window)) {
      load();
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          load();
        }
      },
      { rootMargin: '200px 0px' }
    );
    io.observe(section);
  })();
</script>

{/* is:global: CRM logos are injected without Astro scoped attrs */}
<style is:global>
  #clients .client-logo {
    position: relative;
    display: flex;
    flex: 0 0 auto;
    width: 160px;
    height: 96px;
    box-sizing: border-box;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 0.65rem 0.75rem;
    background: linear-gradient(160deg, #fdfbff 0%, #fff 55%, #faf8fc 100%);
    border: 1px solid rgba(101, 21, 97, 0.18);
    border-radius: 12px;
    box-shadow:
      0 8px 22px rgba(101, 21, 97, 0.12),
      0 0 0 1px rgba(198, 6, 145, 0.04),
      0 0 28px rgba(198, 6, 145, 0.12);
  }

  @media (max-width: 767px) {
    #clients .carousel-outer {
      gap: 0.5rem;
    }

    #clients .carousel-viewport {
      padding-inline: 0;
    }

    #clients .client-logo {
      width: calc((100% - 1rem) / 2);
      height: 88px;
      padding: 0.5rem 0.6rem;
      opacity: 1 !important;
    }

    #clients .carousel-arrow {
      position: static;
      inset: auto;
      flex: 0 0 2.5rem;
      transform: none;
    }
  }

  @media (min-width: 768px) {
    #clients .client-logo {
      width: calc((100% - 4.5rem) / 4);
      height: 124px;
      padding: 0.75rem 0.9rem;
    }
  }

  #clients .client-logo img {
    display: block;
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  /* Give the soft elevation room to fade instead of clipping at the edges. */
  #clients [data-carousel-strip] {
    padding-block: 1.25rem 1.75rem;
  }
</style>
