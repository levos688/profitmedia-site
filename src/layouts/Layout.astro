---
import '../styles/global.css';
import '../styles/a11y-contrast.css';
import { localeMeta, normalizeLocale, type Locale } from '../i18n/config';
import type { RouteId } from '../i18n/routes';
import { getOgLocale, getRouteAlternates } from '../i18n/seo';

type AlternateLink = {
  hreflang: string;
  href: string;
};

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  twitterCard?: 'summary' | 'summary_large_image';
  noindex?: boolean;
  blockAiCrawlers?: boolean;
  preloadImage?: string | false;
  enableGtm?: boolean;
  metaPixelId?: string;
  metaPixelLead?: boolean;
  locale?: Locale;
  /** @deprecated Use locale. Kept while existing internal dashboards migrate. */
  lang?: Locale;
  /** @deprecated Direction is derived from locale. */
  dir?: 'ltr' | 'rtl';
  routeId?: RouteId;
  alternates?: AlternateLink[];
  /** SEO language alternates default off for noindex pages; routeId still supports UI routing. */
  emitAlternates?: boolean;
  enableA11y?: boolean;
}

const DEFAULT_OG_IMAGE = 'https://profitmedia.co.il/icons/site-icon.png';

const {
  title = 'פרסום באינטרנט | פרסום שמביא רווחים | Profit Media',
  description = 'פרסום באינטרנט | פרסום בגוגל | פרסום בפייסבוק | פרסום באינסטגרם | הקמה דפי נחיתה',
  canonical,
  ogImage = DEFAULT_OG_IMAGE,
  ogType = 'website',
  twitterCard,
  noindex = false,
  emitAlternates = !noindex,
  blockAiCrawlers = false,
  preloadImage = '/images/hero/photo-min.svg',
  enableGtm = true,
  metaPixelId,
  metaPixelLead = false,
  locale: localeProp,
  routeId,
  alternates: providedAlternates,
  enableA11y = true,
} = Astro.props;

const resolvedTwitterCard =
  twitterCard ?? (ogImage !== DEFAULT_OG_IMAGE ? 'summary_large_image' : 'summary');

const locale = normalizeLocale(localeProp ?? Astro.props.lang);
const lang = locale;
const dir = localeMeta[locale].dir;
const alternates = emitAlternates
  ? (providedAlternates ?? (routeId ? getRouteAlternates(routeId) : []))
  : [];
const canonicalUrl = canonical ?? Astro.url.href;
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Bump this when shipping a site fix so we can confirm prod did not roll back. */}
    <meta name="pm-release" content="2026-08-16-proposal-title-2" />
    {
      enableGtm && (
        <script is:inline>
          (function (w, d, s, l, i) {
            w[l] = w[l] || [];
            w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
            var f = d.getElementsByTagName(s)[0],
              j = d.createElement(s),
              dl = l != 'dataLayer' ? '&l=' + l : '';
            j.async = true;
            j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
            f.parentNode.insertBefore(j, f);
          })(window, document, 'script', 'dataLayer', 'GTM-57J48TC');
        </script>
      )
    }
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {
      alternates.map(({ hreflang, href }) => (
        <link rel="alternate" hreflang={hreflang} href={href} />
      ))
    }
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM site context" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={getOgLocale(locale)} />
    <meta
      property="og:locale:alternate"
      content={locale === 'he' ? localeMeta.ru.ogLocale : localeMeta.he.ogLocale}
    />
    <meta property="og:site_name" content="Profit Media" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content={resolvedTwitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {
      noindex && (
        <>
          <meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex, max-image-preview:none, max-snippet:0" />
          <meta name="googlebot" content="noindex, nofollow, noarchive, nosnippet" />
          <meta name="bingbot" content="noindex, nofollow, noarchive, nosnippet" />
        </>
      )
    }
    {
      blockAiCrawlers && (
        <>
          <meta name="GPTBot" content="noindex, nofollow" />
          <meta name="ChatGPT-User" content="noindex, nofollow" />
          <meta name="CCBot" content="noindex, nofollow" />
          <meta name="anthropic-ai" content="noindex, nofollow" />
          <meta name="ClaudeBot" content="noindex, nofollow" />
          <meta name="Claude-Web" content="noindex, nofollow" />
          <meta name="Google-Extended" content="noindex, nofollow" />
          <meta name="PerplexityBot" content="noindex, nofollow" />
          <meta name="Applebot-Extended" content="noindex, nofollow" />
          <meta name="Bytespider" content="noindex, nofollow" />
          <meta name="Amazonbot" content="noindex, nofollow" />
          <meta name="cohere-ai" content="noindex, nofollow" />
          <meta name="Diffbot" content="noindex, nofollow" />
        </>
      )
    }
    <link rel="icon" href="/favicon.ico?v=3" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/site-icon.png?v=3" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png?v=3" />
    <meta name="theme-color" content="#651561" />
    {
      preloadImage && (
        <link
          rel="preload"
          href={preloadImage}
          as="image"
          type={
            preloadImage.endsWith('.webp')
              ? 'image/webp'
              : preloadImage.endsWith('.png')
                ? 'image/png'
                : preloadImage.endsWith('.jpg') || preloadImage.endsWith('.jpeg')
                  ? 'image/jpeg'
                  : 'image/svg+xml'
          }
          fetchpriority="high"
        />
      )
    }
    <link
      rel="preload"
      href="/fonts/assistant-hebrew-700-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
    {
      enableGtm && (
        <script is:inline define:vars={{ locale }}>
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({ event: 'page_context', page_language: locale });
        </script>
      )
    }
    {
      metaPixelId && (
        <>
          <script is:inline define:vars={{ metaPixelId, metaPixelLead }}>
            (function (pixelId, fireLead) {
              var loaded = false;

              function readCookie(name) {
                var match = document.cookie.match(new RegExp('(?:^|; )' + name + '=([^;]*)'));
                return match ? decodeURIComponent(match[1]) : '';
              }

              function sendCapi(event, eventId) {
                fetch('/api/meta-event', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({
                    event: event,
                    eventId: eventId,
                    pageUrl: location.href,
                    tracking: { fbp: readCookie('_fbp'), fbc: readCookie('_fbc') },
                  }),
                }).catch(function () {});
              }

              function loadPixel() {
                if (loaded) return;
                loaded = true;

                !function (f, b, e, v, n, t, s) {
                  if (f.fbq) return;
                  n = f.fbq = function () {
                    n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
                  };
                  if (!f._fbq) f._fbq = n;
                  n.push = n;
                  n.loaded = !0;
                  n.version = '2.0';
                  n.queue = [];
                  t = b.createElement(e);
                  t.async = !0;
                  t.src = v;
                  s = b.getElementsByTagName(e)[0];
                  s.parentNode.insertBefore(t, s);
                }(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');

                fbq('init', pixelId);
                var pageViewEventId = '';
                try {
                  pageViewEventId = crypto.randomUUID();
                } catch (e) {
                  pageViewEventId = String(Date.now());
                }
                fbq('track', 'PageView', {}, { eventID: pageViewEventId });
                sendCapi('PageView', pageViewEventId);

                if (!fireLead) return;

                var leadEventId = '';
                try {
                  leadEventId = sessionStorage.getItem('donhin_lead_event_id') || '';
                  sessionStorage.removeItem('donhin_lead_event_id');
                } catch (e) {}
                if (leadEventId) {
                  fbq('track', 'Lead', {}, { eventID: leadEventId });
                } else {
                  fbq('track', 'Lead');
                }
              }

              loadPixel();
            })(metaPixelId, metaPixelLead);
          </script>
          <noscript>
            <img
              height="1"
              width="1"
              style="display:none"
              src={`https://www.facebook.com/tr?id=${metaPixelId}&ev=PageView&noscript=1`}
              alt=""
            />
            {
              metaPixelLead && (
                <img
                  height="1"
                  width="1"
                  style="display:none"
                  src={`https://www.facebook.com/tr?id=${metaPixelId}&ev=Lead&noscript=1`}
                  alt=""
                />
              )
            }
          </noscript>
        </>
      )
    }
    <slot name="head" />
  </head>
  <body class="bg-white text-gray-900 antialiased">
    {
      enableGtm && (
        <noscript>
          <iframe
            src="https://www.googletagmanager.com/ns.html?id=GTM-57J48TC"
            height="0"
            width="0"
            style="display:none;visibility:hidden"
          />
        </noscript>
      )
    }
    <a href="#main-content" class="skip-link">
      {locale === 'he' ? 'דילוג לתוכן' : 'Перейти к содержанию'}
    </a>
    <slot />
    <slot name="scripts" />
    {
      enableA11y && (
        <>
          <script is:inline>
            (function () {
              var loaded = false;
              var LOAD_DELAY_MS = 400;

              function loadA11y() {
                if (loaded) return;
                loaded = true;
                var s = document.createElement('script');
                s.src = 'https://profitmedia.co.il/a11y/v1/profitmedia.js?v=3.7.1';
                s.defer = true;
                document.body.appendChild(s);
              }

              // Load shortly after first paint so LCP stays clean, without waiting for a click.
              if (document.readyState === 'complete') {
                window.setTimeout(loadA11y, LOAD_DELAY_MS);
              } else {
                window.addEventListener(
                  'load',
                  function () {
                    window.setTimeout(loadA11y, LOAD_DELAY_MS);
                  },
                  { once: true }
                );
              }

              // If the user interacts earlier, bring the widget in immediately.
              ['pointerdown', 'keydown', 'touchstart'].forEach(function (type) {
                window.addEventListener(type, loadA11y, { once: true, passive: true });
              });
            })();
          </script>
          <script is:inline>
            (function () {
              /* FAB stays mid-left. Open panel docks to the physical left edge
                 at full viewport height so reset/footer/branding stay on screen. */
              var STYLE_ID = 'pm-a11y-edge-fab';
              var FAB_TOP = '66.666%';

              function pinFab(el) {
                el.style.setProperty('top', FAB_TOP, 'important');
                el.style.setProperty('bottom', 'auto', 'important');
                el.style.setProperty('left', '0', 'important');
                el.style.setProperty('right', 'auto', 'important');
                el.style.setProperty('transform', 'translateY(-50%)', 'important');
                el.style.setProperty('margin', '0', 'important');
              }

              function pinPanel(el) {
                el.style.setProperty('top', '0', 'important');
                el.style.setProperty('bottom', '0', 'important');
                el.style.setProperty('left', '0', 'important');
                el.style.setProperty('right', 'auto', 'important');
                el.style.setProperty('transform', 'none', 'important');
                el.style.setProperty('margin', '0', 'important');
                el.style.setProperty('height', '100dvh', 'important');
                el.style.setProperty('max-height', '100dvh', 'important');
              }

              function relabelContrast(shadow) {
                var tile = shadow.querySelector('[data-tile="contrast-high"] span:last-of-type');
                if (!tile) return;
                var active = shadow.querySelector('.pm-lang-chip.active');
                var lang = active ? active.getAttribute('data-lang') : 'he';
                var labels = {
                  he: 'צהוב על שחור',
                  en: 'Yellow on black',
                  ru: 'Жёлтый на чёрном',
                };
                tile.textContent = labels[lang] || labels.he;
              }

              function applyEdgeFab(shadow) {
                if (!shadow) return false;
                var fab = shadow.querySelector('.pm-fab');
                var panel = shadow.querySelector('.pm-panel');
                if (!fab) return false;

                if (!shadow.getElementById(STYLE_ID)) {
                  var style = document.createElement('style');
                  style.id = STYLE_ID;
                  style.textContent =
                    '.pm-fab{top:66.666%!important;bottom:auto!important;left:0!important;right:auto!important;' +
                    'transform:translateY(-50%)!important;margin:0!important;width:46px!important;height:46px!important;' +
                    'border-radius:0 999px 999px 0!important;box-shadow:2px 2px 10px rgba(0,0,0,.2)!important;}' +
                    '.pm-fab:hover,.pm-fab:focus{transform:translateY(-50%) scale(1.05)!important;}' +
                    '.pm-fab-icon svg{width:26px!important;height:26px!important;}' +
                    '.pm-panel{top:0!important;bottom:0!important;left:0!important;right:auto!important;' +
                    'transform:none!important;margin:0!important;height:100dvh!important;max-height:100dvh!important;' +
                    'width:min(370px,100vw)!important;max-width:min(370px,100vw)!important;border-radius:0!important;}' +
                    '#pm-a11y-panel-inner{height:100%!important;max-height:100%!important;}' +
                    '.pm-brand{border-radius:0!important}' +
                    '.pm-cat-ico{display:none!important}' +
                    '[data-tile="keyboard"],[data-tile="mute"],[data-tile="tts-page"],[data-tile="tts-select"]{display:none!important}' +
                    '@media (max-width:480px){.pm-fab{width:36px!important;height:36px!important;}' +
                    '.pm-fab-icon svg{width:20px!important;height:20px!important;}' +
                    '.pm-panel{width:100vw!important;max-width:100vw!important;}}';
                  shadow.appendChild(style);
                }

                pinFab(fab);
                if (panel) pinPanel(panel);
                relabelContrast(shadow);
                return true;
              }

              function positionA11yWidget() {
                var root = document.getElementById('pm-a11y-widget-root');
                if (!root || !root.shadowRoot) return false;
                if (root.parentNode !== document.documentElement) {
                  document.documentElement.appendChild(root);
                }
                return applyEdgeFab(root.shadowRoot);
              }

              var ticks = 0;
              var timer = window.setInterval(function () {
                positionA11yWidget();
                ticks += 1;
                if (ticks >= 120) window.clearInterval(timer);
              }, 250);

              if (typeof MutationObserver !== 'undefined') {
                var observer = new MutationObserver(function () {
                  positionA11yWidget();
                });
                observer.observe(document.documentElement, { childList: true, subtree: true });
                window.setTimeout(function () {
                  observer.disconnect();
                }, 45000);
              }

              window.addEventListener('resize', positionA11yWidget, { passive: true });
            })();
          </script>
        </>
      )
    }
    <script is:inline>
      (function () {
        try {
          if (!sessionStorage.getItem('pm_first_landing')) {
            sessionStorage.setItem('pm_first_landing', location.href);
            var params = new URL(location.href).searchParams;
            var utm = {};
            ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term', 'gclid', 'gbraid', 'wbraid', 'fbclid'].forEach(
              function (key) {
                var value = params.get(key);
                if (value) utm[key] = value;
              }
            );
            if (Object.keys(utm).length) {
              sessionStorage.setItem('pm_first_utm', JSON.stringify(utm));
            }
            if (document.referrer) {
              sessionStorage.setItem('pm_first_referrer', document.referrer);
            }
          }
        } catch (e) {}

        /** First-touch UTM + landing + referrer for CRM attribution. */
        window.pmGetLeadAttribution = function () {
          var keys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term', 'gclid', 'gbraid', 'wbraid', 'fbclid'];
          var currentUtm = {};
          try {
            var pageUrl = new URL(window.location.href);
            keys.forEach(function (key) {
              var value = pageUrl.searchParams.get(key);
              if (value) currentUtm[key] = value;
            });
          } catch (e) {}
          var firstUtm = {};
          try {
            var stored = sessionStorage.getItem('pm_first_utm');
            if (stored) firstUtm = JSON.parse(stored);
          } catch (e) {}
          var landingUrl = window.location.href;
          var referrer = document.referrer || '';
          try {
            landingUrl = sessionStorage.getItem('pm_first_landing') || window.location.href;
            referrer = sessionStorage.getItem('pm_first_referrer') || document.referrer || '';
          } catch (e) {}
          return {
            utm: Object.assign({}, currentUtm, firstUtm),
            landingUrl: landingUrl,
            referrer: referrer,
          };
        };

        /** Desk | Mob — match site mobile breakpoint used by sticky CTA. */
        window.pmDeviceClass = function () {
          try {
            return window.matchMedia('(max-width: 767px)').matches ? 'Mob' : 'Desk';
          } catch (e) {
            return 'Desk';
          }
        };

        function initReveal() {
          var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          var revealEls = document.querySelectorAll('[data-reveal]');

          if (!revealEls.length) return;

          if (reduceMotion) {
            revealEls.forEach(function (el) {
              el.classList.add('is-visible');
            });
            return;
          }

          var observer = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (!entry.isIntersecting) return;
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              });
            },
            // Generous rootMargin so elements aren't blocked by sticky mobile CTA /
            // iOS Safari bottom chrome before they become visible.
            { threshold: 0.01, rootMargin: '0px 0px 20% 0px' }
          );

          revealEls.forEach(function (el) {
            var rect = el.getBoundingClientRect();
            var vh = window.innerHeight || document.documentElement.clientHeight;
            // Already on screen (or just below) — show immediately without waiting for IO.
            if (rect.top < vh * 1.05 && rect.bottom > 0) {
              el.classList.add('is-visible');
              return;
            }
            observer.observe(el);
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initReveal);
        } else {
          initReveal();
        }
      })();
    </script>
  </body>
</html>
