---
import Layout from '../../layouts/Layout.astro';
import { getUi } from '../../i18n/content';

const locale = 'ru';
const { thankYou } = getUi(locale);
---

<Layout
  title={thankYou.title}
  description={thankYou.description}
  locale={locale}
  routeId="thankYou"
  canonical="https://profitmedia.co.il/ru/thank-you/"
  noindex
>
  <main
    id="main-content"
    class="flex min-h-screen flex-col items-center justify-center bg-white px-4 py-16 text-center"
  >
    <a href="/ru/" class="mb-10 block" aria-label="Profit Media, главная">
      <img src="/logo.svg?v=20260816" alt="Profit Media" class="mx-auto h-14 w-auto md:h-[70px]" width="200" height="70" />
    </a>

    <div class="max-w-lg">
      <h1 class="text-3xl leading-tight font-black text-brand-purple md:text-5xl">
        {thankYou.heading}
      </h1>
      <p class="mt-5 text-xl leading-relaxed text-gray-600 md:text-2xl">
        {thankYou.message}
      </p>
      <a
        href="/ru/"
        class="btn-yellow mt-10 inline-flex rounded-full px-8 py-3 text-base font-black"
      >
        {thankYou.backHome}
      </a>
    </div>
  </main>
</Layout>
