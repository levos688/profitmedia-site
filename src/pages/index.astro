---
import Layout from '../layouts/Layout.astro';
import '../styles/preview.css';
import Header from '../components/Header.astro';
import PreviewHero from '../components/preview/PreviewHero.astro';
import HomeJsonLd from '../components/HomeJsonLd.astro';
import AgencyStats from '../components/AgencyStats.astro';
import DealsContrast from '../components/deals/DealsContrast.astro';
import DealsSystemProcess from '../components/deals/system/DealsSystemProcess.astro';
import DealsResults from '../components/deals/DealsResults.astro';
import TargetAudience from '../components/TargetAudience.astro';
import Clients from '../components/Clients.astro';
import NamedOffer from '../components/NamedOffer.astro';
import VideoTestimonials from '../components/VideoTestimonials.astro';
import PreviewPortfolio from '../components/preview/PreviewPortfolio.astro';
import PreviewFaq from '../components/preview/PreviewFaq.astro';
import BlogPreview from '../components/BlogPreview.astro';
import PreviewContactForm from '../components/preview/PreviewContactForm.astro';
import LeadCaptureModal from '../components/preview/LeadCaptureModal.astro';
import StickyMobileCta from '../components/preview/StickyMobileCta.astro';
import HomeAbPopup from '../components/preview/HomeAbPopup.astro';
import Footer from '../components/Footer.astro';
import { getContent } from '../i18n/content';

const locale = 'he';
const { home, ui } = getContent(locale);
---

<Layout
  title={home.seo.title}
  description={home.seo.description}
  canonical={home.seo.canonical}
  preloadImage="/images/hero/photo-min.svg"
  locale={locale}
  routeId="home"
>
  <HomeJsonLd slot="head" locale={locale} content={home} />
  <div
    class="preview-page"
    data-lead-page
    data-locale={locale}
    data-lead-source="homepage"
    data-lead-source-prefix="home"
    data-thank-you="/thank-you"
  >
    <Header locale={locale} routeId="home" nav={home.nav} cta={home.cta} />
    <main id="main-content">
      {/* CRO order: mechanism → proof → qualify → objections → CTA; blog last (SEO, low conversion weight) */}
      <PreviewHero content={home.hero} illustrationAlt="פרסום דיגיטלי — איור" />
      <AgencyStats stats={home.agencyStats} />
      <DealsContrast content={home.dealsContrast} />
      <DealsSystemProcess sectionId="how-it-works" content={home.dealsProcess} />
      <DealsResults content={home.dealsResults} />
      <NamedOffer content={home.namedOffer} fallbackCta={home.cta} includesTitle={ui.sections.offerIncludes} />
      <Clients
        logos={home.clientLogos}
        title={ui.sections.clients}
        ariaLabel={ui.accessibility.carouselClients}
        nextLabel={ui.accessibility.carouselNext}
        previousLabel={ui.accessibility.carouselPrevious}
      />
      <TargetAudience content={home.targetAudience} outcomeLabel={ui.sections.audienceOutcome} />
      <VideoTestimonials videos={home.videoTestimonials} title={ui.sections.videoTestimonials} videoPlayerLabel={ui.accessibility.videoPlayer} />
      <PreviewPortfolio
        landings={home.landings}
        labels={ui.portfolio}
        carouselLabel={ui.accessibility.carouselLandings}
        nextLabel={ui.accessibility.carouselNext}
        previousLabel={ui.accessibility.carouselPrevious}
      />
      <PreviewFaq items={home.faqs} title={ui.sections.faqTitle} subtitle={ui.sections.faqSubtitle} />
      <PreviewContactForm />
      <BlogPreview labels={ui.blog} />
    </main>
    <Footer locale={locale} routeId="home" />
    <LeadCaptureModal />
    <HomeAbPopup locale={locale} />
    <StickyMobileCta label={home.cta} ariaLabel={ui.accessibility.ctaRegion} />
  </div>
  <script src="/scripts/pm-home-ab.js?v=20260729a" defer></script>
</Layout>
