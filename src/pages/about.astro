---
import Layout from '../layouts/Layout.astro';
import '../styles/preview.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AboutContent from '../components/AboutContent.astro';
import LeadCaptureModal from '../components/preview/LeadCaptureModal.astro';
import PreviewContactForm from '../components/preview/PreviewContactForm.astro';
import { getContent } from '../i18n/content';

const locale = 'he';
const { about, home } = getContent(locale);
const canonicalUrl = about.seo.canonical;
const aboutSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'AboutPage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: about.seo.title,
      description: about.seo.description,
      inLanguage: 'he-IL',
      isPartOf: { '@id': 'https://profitmedia.co.il/#website' },
      about: { '@id': 'https://profitmedia.co.il/#organization' },
      mainEntity: { '@id': `${canonicalUrl}#person` },
    },
    {
      '@type': 'Person',
      '@id': `${canonicalUrl}#person`,
      name: about.founder.name,
      url: `${canonicalUrl}#founder`,
      jobTitle: about.founder.role,
      worksFor: { '@type': 'Organization', name: 'Profit Media', url: 'https://profitmedia.co.il/' },
      email: about.founder.email,
      image: `https://profitmedia.co.il${about.founder.imageFallback}`,
      description: about.founder.paragraphs.join(' '),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'דף הבית', item: 'https://profitmedia.co.il/' },
        { '@type': 'ListItem', position: 2, name: 'מי אנחנו', item: canonicalUrl },
      ],
    },
  ],
};
---

<Layout
  title={about.seo.title}
  description={about.seo.description}
  canonical={canonicalUrl}
  preloadImage={false}
  locale={locale}
  routeId="about"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(aboutSchema)} />
  <div
    data-lead-page
    data-locale={locale}
    data-lead-source="about"
    data-lead-source-prefix="about"
    data-thank-you="/thank-you"
  >
    <Header locale={locale} routeId="about" nav={home.nav} cta={home.cta} />
    <AboutContent content={about}>
      <PreviewContactForm />
    </AboutContent>
    <Footer locale={locale} routeId="about" />
    <LeadCaptureModal />
  </div>
</Layout>
