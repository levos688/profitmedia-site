---
import Layout from '../layouts/Layout.astro';
import '../styles/preview.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LeadCaptureModal from '../components/preview/LeadCaptureModal.astro';
import PreviewContactForm from '../components/preview/PreviewContactForm.astro';
import {
  aboutSeo,
  aboutHero,
  aboutWhat,
  aboutAudience,
  aboutSystem,
  aboutChannels,
  aboutPrinciples,
  aboutStats,
  aboutFounder,
  aboutCta,
} from '../data/about';

const canonicalUrl = aboutSeo.canonical;

const aboutSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'AboutPage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: aboutSeo.title,
      description: aboutSeo.description,
      inLanguage: 'he-IL',
      isPartOf: { '@id': 'https://profitmedia.co.il/#website' },
      about: { '@id': 'https://profitmedia.co.il/#organization' },
      mainEntity: { '@id': `${canonicalUrl}#person` },
    },
    {
      '@type': 'Person',
      '@id': `${canonicalUrl}#person`,
      name: 'לב אוסינובסקי',
      url: `${canonicalUrl}#founder`,
      jobTitle: 'מייסד ומנהל קמפיינים',
      worksFor: {
        '@type': 'Organization',
        name: 'Profit Media',
        url: 'https://profitmedia.co.il/',
      },
      email: aboutFounder.email,
      image: `https://profitmedia.co.il${aboutFounder.imageFallback}`,
      description:
        'מומחה לפרסום ממומן ומערכות המרה לעסקים עם עסקאות גבוהות. כ־18 שנה בפרסום דיגיטלי, כ־13 שנה עצמאי.',
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'דף הבית', item: 'https://profitmedia.co.il/' },
        { '@type': 'ListItem', position: 2, name: 'מי אנחנו', item: canonicalUrl },
      ],
    },
  ],
};
---

<Layout title={aboutSeo.title} description={aboutSeo.description} canonical={canonicalUrl} preloadImage={false}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(aboutSchema)} />
  <Header />
  <main id="main-content" class="about-page">
    <section class="about-hero section-padding">
      <div class="mx-auto max-w-3xl px-4 text-center md:px-6">
        <p class="about-hero__eyebrow">{aboutHero.eyebrow}</p>
        <h1 class="about-hero__title">{aboutHero.title}</h1>
        <p class="about-hero__subtitle">{aboutHero.subtitle}</p>
      </div>
    </section>

    <section class="about-section section-padding pt-0" aria-labelledby="about-what-title">
      <div class="mx-auto max-w-3xl px-4 md:px-6">
        <h2 id="about-what-title" class="about-section__title">{aboutWhat.title}</h2>
        {
          aboutWhat.paragraphs.map((p) => (
            <p class="about-section__text">{p}</p>
          ))
        }
      </div>
    </section>

    <section class="about-section about-section--soft section-padding" aria-labelledby="about-audience-title">
      <div class="mx-auto max-w-3xl px-4 md:px-6">
        <h2 id="about-audience-title" class="about-section__title">{aboutAudience.title}</h2>
        <p class="about-section__text">{aboutAudience.intro}</p>
        <ul class="about-list">
          {aboutAudience.items.map((item) => <li>{item}</li>)}
        </ul>
        <p class="about-section__text about-section__text--muted">{aboutAudience.notFor}</p>
      </div>
    </section>

    <section class="about-section section-padding" aria-labelledby="about-system-title">
      <div class="mx-auto max-w-3xl px-4 md:px-6">
        <h2 id="about-system-title" class="about-section__title">{aboutSystem.title}</h2>
        <p class="about-section__text">{aboutSystem.intro}</p>
        {
          aboutSystem.blocks.map((block) => (
            <div class="about-block">
              <h3 class="about-block__title">{block.title}</h3>
              <p class="about-section__text">{block.body}</p>
              {block.items.length > 0 && (
                <ul class="about-list">
                  {block.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              )}
              {block.note && <p class="about-section__text about-section__text--emphasis">{block.note}</p>}
            </div>
          ))
        }
      </div>
    </section>

    <section class="about-section about-section--soft section-padding" aria-labelledby="about-channels-title">
      <div class="mx-auto max-w-3xl px-4 md:px-6">
        <h2 id="about-channels-title" class="about-section__title">{aboutChannels.title}</h2>
        <p class="about-section__text">{aboutChannels.body}</p>
      </div>
    </section>

    <section class="about-section section-padding" aria-labelledby="about-principles-title">
      <div class="mx-auto max-w-3xl px-4 md:px-6">
        <h2 id="about-principles-title" class="about-section__title">{aboutPrinciples.title}</h2>
        <ul class="about-principles">
          {
            aboutPrinciples.items.map((item) => (
              <li>
                <strong>{item.title}.</strong> {item.description}
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="about-section about-section--soft section-padding" aria-labelledby="about-stats-title">
      <div class="mx-auto max-w-3xl px-4 md:px-6">
        <h2 id="about-stats-title" class="about-section__title">{aboutStats.title}</h2>
        <div class="about-stats">
          {
            aboutStats.items.map((item) => (
              <div class="about-stat">
                <p class="about-stat__value">{item.value}</p>
                <p class="about-stat__label">{item.label}</p>
              </div>
            ))
          }
        </div>
        <p class="about-section__text about-section__text--muted">{aboutStats.disclaimer}</p>
      </div>
    </section>

    <section class="about-founder section-padding" id="founder" aria-labelledby="about-founder-title">
      <div class="mx-auto max-w-6xl px-4 md:px-6">
        <div class="about-founder__grid">
          <div class="about-founder__portrait" aria-hidden="false">
            <div class="about-founder__glow" aria-hidden="true"></div>
            <div class="about-founder__ring">
              <picture>
                <source srcset={aboutFounder.image} type="image/webp" />
                <img
                  src={aboutFounder.imageFallback}
                  alt={aboutFounder.imageAlt}
                  width="720"
                  height="1200"
                  loading="lazy"
                  decoding="async"
                  class="about-founder__photo"
                />
              </picture>
            </div>
            <div class="about-founder__badge">
              <p class="about-founder__name">{aboutFounder.name}</p>
              <p class="about-founder__role">{aboutFounder.role}</p>
            </div>
          </div>

          <div class="about-founder__copy">
            <h2 id="about-founder-title" class="about-section__title">{aboutFounder.title}</h2>
            {
              aboutFounder.paragraphs.map((p) => (
                <p class="about-section__text">{p}</p>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="about-cta-band section-padding" aria-labelledby="about-cta-title">
      <div class="mx-auto max-w-3xl px-4 text-center md:px-6">
        <h2 id="about-cta-title" class="about-cta-band__title">{aboutCta.title}</h2>
        <p class="about-cta-band__text">{aboutCta.body}</p>
        <a href="#contact" class="btn-yellow inline-flex rounded-full px-8 py-3.5 text-base font-black">
          {aboutCta.button}
        </a>
      </div>
    </section>

    <PreviewContactForm />
  </main>
  <Footer />
  <LeadCaptureModal />
</Layout>

<style>
  .about-hero {
    background: linear-gradient(160deg, #faf8fc 0%, #fff 55%, #f8f4fa 100%);
  }

  .about-hero__eyebrow {
    margin: 0;
    color: #c60691;
    font-size: 0.9375rem;
    font-weight: 800;
  }

  .about-hero__title {
    margin: 0.5rem 0 0;
    font-size: 2.125rem;
    line-height: 1.25;
    font-weight: 900;
    color: #111827;
  }

  .about-hero__subtitle {
    margin: 1.1rem auto 0;
    max-width: 40rem;
    font-size: 1.125rem;
    line-height: 1.7;
    color: #4b5563;
  }

  @media (min-width: 768px) {
    .about-hero__title {
      font-size: 2.75rem;
    }
  }

  .about-section__title {
    margin: 0 0 1.25rem;
    font-size: 1.625rem;
    line-height: 1.3;
    font-weight: 900;
    color: #29102c;
  }

  @media (min-width: 768px) {
    .about-section__title {
      font-size: 1.875rem;
    }
  }

  .about-section__text {
    margin: 0 0 1.1rem;
    font-size: 1.0625rem;
    line-height: 1.8;
    color: #374151;
  }

  .about-section__text--muted {
    color: #6b7280;
  }

  .about-section__text--emphasis {
    color: #29102c;
    font-weight: 600;
  }

  .about-section--soft {
    background: #faf8fc;
  }

  .about-list {
    margin: 0 0 1.25rem;
    padding: 0;
    list-style: none;
  }

  .about-list li {
    position: relative;
    margin: 0 0 0.65rem;
    padding-inline-start: 1.35rem;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: #374151;
  }

  .about-list li::before {
    content: '';
    position: absolute;
    top: 0.55rem;
    inset-inline-start: 0;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #651561;
  }

  .about-block {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid #e8e0ec;
  }

  .about-block:first-of-type {
    margin-top: 1.5rem;
  }

  .about-block__title {
    margin: 0 0 0.75rem;
    font-size: 1.2rem;
    font-weight: 800;
    color: #29102c;
  }

  .about-principles {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .about-principles li {
    margin: 0 0 1rem;
    padding: 1rem 1.15rem;
    border-radius: 4px;
    background: #faf8fc;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: #374151;
  }

  .about-principles strong {
    color: #29102c;
  }

  .about-stats {
    display: grid;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  @media (min-width: 640px) {
    .about-stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .about-stat {
    padding: 1.15rem 1rem;
    border-radius: 4px;
    background: #fff;
    border: 1px solid #e8e0ec;
    text-align: center;
  }

  .about-stat__value {
    margin: 0;
    font-size: 1.75rem;
    font-weight: 900;
    color: #651561;
    line-height: 1.2;
  }

  .about-stat__label {
    margin: 0.4rem 0 0;
    font-size: 0.875rem;
    line-height: 1.45;
    color: #4b5563;
  }

  .about-founder {
    background: linear-gradient(165deg, #faf8fc 0%, #fff 45%, #f7f2f8 100%);
    overflow: hidden;
  }

  .about-founder__grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .about-founder__grid {
      grid-template-columns: minmax(240px, 320px) minmax(0, 1fr);
      gap: 3.5rem;
    }
  }

  .about-founder__portrait {
    position: relative;
    max-width: 280px;
    margin-inline: auto;
  }

  @media (min-width: 900px) {
    .about-founder__portrait {
      max-width: none;
      margin-inline: 0;
    }
  }

  .about-founder__glow {
    position: absolute;
    inset: -12% -18% -8%;
    background:
      radial-gradient(ellipse at 30% 20%, rgba(198, 6, 145, 0.18), transparent 55%),
      radial-gradient(ellipse at 80% 80%, rgba(101, 21, 97, 0.22), transparent 60%),
      radial-gradient(ellipse at 50% 100%, rgba(252, 192, 0, 0.16), transparent 50%);
    filter: blur(2px);
    z-index: 0;
    pointer-events: none;
  }

  .about-founder__ring {
    position: relative;
    z-index: 1;
    padding: 4px;
    border-radius: 18px;
    background: linear-gradient(145deg, #c60691 0%, #651561 42%, #5a1c73 72%, #fcc000 100%);
    box-shadow:
      0 18px 40px rgba(101, 21, 97, 0.18),
      0 2px 0 rgba(255, 255, 255, 0.35) inset;
  }

  .about-founder__ring::before {
    content: '';
    position: absolute;
    top: -10px;
    inset-inline-end: -10px;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 2px solid rgba(252, 192, 0, 0.55);
    z-index: 2;
    pointer-events: none;
  }

  .about-founder__ring::after {
    content: '';
    position: absolute;
    bottom: 18%;
    inset-inline-start: -14px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #fcc000;
    box-shadow: 0 0 0 6px rgba(252, 192, 0, 0.2);
    z-index: 2;
    pointer-events: none;
  }

  .about-founder__photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: 42% 0%;
    border-radius: 14px;
    background: #f3eef4;
  }

  .about-founder__badge {
    position: relative;
    z-index: 1;
    margin-top: -1.25rem;
    margin-inline: 1rem 0;
    padding: 0.85rem 1.1rem;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.96);
    border: 1px solid rgba(101, 21, 97, 0.1);
    box-shadow: 0 10px 28px rgba(41, 16, 44, 0.1);
    text-align: right;
  }

  .about-founder__name {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 900;
    color: #29102c;
  }

  .about-founder__role {
    margin: 0.2rem 0 0;
    font-size: 0.875rem;
    font-weight: 600;
    color: #c60691;
  }

  .about-founder__copy .about-section__title {
    margin-top: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .about-founder__ring {
      transition: transform 250ms ease-out, box-shadow 250ms ease-out;
    }

    .about-founder__portrait:hover .about-founder__ring {
      transform: translateY(-3px);
      box-shadow:
        0 22px 48px rgba(101, 21, 97, 0.22),
        0 2px 0 rgba(255, 255, 255, 0.35) inset;
    }
  }

  .about-cta-band {
    background: linear-gradient(160deg, #651561 0%, #5a1c73 55%, #4a1558 100%);
    color: #fff;
  }

  .about-cta-band__title {
    margin: 0;
    font-size: 1.75rem;
    font-weight: 900;
  }

  .about-cta-band__text {
    margin: 1rem auto 1.5rem;
    max-width: 38rem;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.9);
  }
</style>
