---
import Layout from '../../layouts/Layout.astro';
import '../../styles/preview.css';
import AdsLpHeader from '../../components/ads/AdsLpHeader.astro';
import PreviewHero from '../../components/preview/PreviewHero.astro';
import AgencyStats from '../../components/AgencyStats.astro';
import DealsContrast from '../../components/deals/DealsContrast.astro';
import DealsSystemProcess from '../../components/deals/system/DealsSystemProcess.astro';
import DealsResults from '../../components/deals/DealsResults.astro';
import TargetAudience from '../../components/TargetAudience.astro';
import Clients from '../../components/Clients.astro';
import NamedOffer from '../../components/NamedOffer.astro';
import VideoTestimonials from '../../components/VideoTestimonials.astro';
import DealsContactForm from '../../components/deals/DealsContactForm.astro';
import DealsStickyCta from '../../components/deals/DealsStickyCta.astro';
import Footer from '../../components/Footer.astro';

/**
 * Clean Google Ads landing page — same content as the keyword LP,
 * without client-side A/B, popups, or DOM reordering (policy-safe).
 */
const title = 'סוכנות פרסום דיגיטלי | אבחון קמפיין חינם | Profit Media';
const h1 = 'סוכנות פרסום דיגיטלי לעסקאות, לא רק ללידים';
const description =
  'מערכת שמחברת פרסום לעסקאות: מחקר מתחרים, קמפיינים, דף נחיתה ו־CRM. אבחון קמפיין חינם תוך 24 שעות, בלי התחייבות.';
const canonical = 'https://profitmedia.co.il/lp/agency/';
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  noindex
  preloadImage="/images/hero/photo-min.svg"
>
  <div
    class="preview-page"
    data-lead-page
    data-lead-source="lp-agency"
    data-lead-source-prefix="lp"
    data-thank-you="/thank-you"
  >
    <AdsLpHeader />
    <main id="main-content">
      <PreviewHero overrideTitle={h1} />
      <AgencyStats />
      <DealsResults />
      <DealsContrast />
      <DealsSystemProcess sectionId="how-it-works" />
      <NamedOffer />
      <Clients />
      <TargetAudience />
      <VideoTestimonials />
      <DealsContactForm />
    </main>
    <Footer minimal />
    <DealsStickyCta />
  </div>

  <script>
    document.querySelectorAll('[data-lead-modal-open]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const contactSection = document.getElementById('contact');
        if (!contactSection) return;
        contactSection.scrollIntoView({ behavior: 'smooth' });
        const firstInput = contactSection.querySelector('input:not([type="hidden"])');
        if (firstInput instanceof HTMLElement) {
          setTimeout(() => firstInput.focus(), 600);
        }
      });
    });
  </script>
</Layout>
