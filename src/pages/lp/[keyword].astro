---
import Layout from '../../layouts/Layout.astro';
import '../../styles/preview.css';
import AdsLpHeader from '../../components/ads/AdsLpHeader.astro';
import PreviewHero from '../../components/preview/PreviewHero.astro';
import AgencyStats from '../../components/AgencyStats.astro';
import DealsContrast from '../../components/deals/DealsContrast.astro';
import DealsSystemProcess from '../../components/deals/system/DealsSystemProcess.astro';
import DealsResults from '../../components/deals/DealsResults.astro';
import TargetAudience from '../../components/TargetAudience.astro';
import Clients from '../../components/Clients.astro';
import NamedOffer from '../../components/NamedOffer.astro';
import VideoTestimonials from '../../components/VideoTestimonials.astro';
import DealsContactForm from '../../components/deals/DealsContactForm.astro';
import HomeAbPopup from '../../components/preview/HomeAbPopup.astro';
import DealsStickyCta from '../../components/deals/DealsStickyCta.astro';
import Footer from '../../components/Footer.astro';

export function getStaticPaths() {
  return [
    {
      params: { keyword: 'digital-advertising-agency' },
      props: {
        title: 'סוכנות פרסום דיגיטלי | אבחון קמפיין חינם | Profit Media',
        h1: 'סוכנות פרסום דיגיטלי לעסקאות, לא רק ללידים',
      },
    },
    {
      params: { keyword: 'digital-advertising-office' },
      props: {
        title: 'משרד פרסום דיגיטלי | אבחון קמפיין חינם | Profit Media',
        h1: 'משרד פרסום דיגיטלי לעסקאות, לא רק ללידים',
      },
    },
  ];
}

const { keyword } = Astro.params;
const { title, h1 } = Astro.props;

const description = 'מערכת שמחברת פרסום לעסקאות: מחקר מתחרים, קמפיינים, דף נחיתה ו־CRM. אבחון קמפיין חינם תוך 24 שעות, בלי התחייבות.';
const canonical = `https://profitmedia.co.il/lp/${keyword}/`;
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  noindex
  preloadImage="/images/hero/photo-min.svg"
>
  <Fragment slot="head">
    <script is:inline>
      (function () {
        var slug = (window.location.pathname.match(/\/lp\/([^/]+)/) || [])[1] || '';
        var prefix = slug === 'digital-advertising-agency' ? 'agency' : 'office';
        var key = 'pm_lp_ab_v2_' + prefix;
        var variants = ['proof_first', 'mechanism_first'];
        var params = new URL(window.location.href).searchParams;
        var forced = params.get('force_order');
        var value = variants.indexOf(forced) !== -1 ? forced : '';
        var assignments = {};
        try {
          assignments = JSON.parse(localStorage.getItem(key) || '{}');
          if (!value) value = assignments.page_order || '';
          if (variants.indexOf(value) === -1) {
            value = variants[Math.random() < 0.5 ? 0 : 1];
          }
          assignments.page_order = value;
          localStorage.setItem(key, JSON.stringify(assignments));
        } catch (e) {
          if (!value) value = variants[Math.random() < 0.5 ? 0 : 1];
        }
        document.documentElement.dataset.pmLpOrder = value;
      })();
    </script>
  </Fragment>

  <div
    class="preview-page"
    data-lead-page
    data-lead-source={`lp-${keyword}`}
    data-lead-source-prefix="lp"
    data-thank-you="/thank-you"
    data-lp-keyword={keyword}
  >
    <AdsLpHeader />
    <main id="main-content">
      <PreviewHero overrideTitle={h1} />
      <AgencyStats />

      <div class="lp-test-sections" data-lp-test-sections>
        <div class="lp-test-block lp-test-block--results" data-lp-block="results">
          <DealsResults />
        </div>
        <div class="lp-test-block lp-test-block--contrast" data-lp-block="contrast">
          <DealsContrast />
        </div>
        <div class="lp-test-block lp-test-block--process" data-lp-block="process">
          <DealsSystemProcess sectionId="how-it-works" />
        </div>
      </div>

      <NamedOffer />
      <Clients />
      <TargetAudience />
      <VideoTestimonials />
      <DealsContactForm />
    </main>
    <Footer minimal />
    <DealsStickyCta />
  </div>

  <script>
    // Safe anchor scrolling without complex tracking for Google Ads compliance
    document.querySelectorAll('[data-lead-modal-open]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const contactSection = document.getElementById('contact');
        if (contactSection) {
          contactSection.scrollIntoView({ behavior: 'smooth' });
          // Focus first input for accessibility
          const firstInput = contactSection.querySelector('input:not([type="hidden"])');
          if (firstInput) {
            setTimeout(() => firstInput.focus(), 600);
          }
        }
      });
    });
  </script>
</Layout>

<style is:global>
  .lp-test-sections {
    display: flex;
    flex-direction: column;
  }

  html[data-pm-lp-order='proof_first'] .lp-test-block--results {
    order: 1;
  }

  html[data-pm-lp-order='proof_first'] .lp-test-block--contrast {
    order: 2;
  }

  html[data-pm-lp-order='proof_first'] .lp-test-block--process {
    order: 3;
  }

  html[data-pm-lp-order='mechanism_first'] .lp-test-block--contrast {
    order: 1;
  }

  html[data-pm-lp-order='mechanism_first'] .lp-test-block--process {
    order: 2;
  }

  html[data-pm-lp-order='mechanism_first'] .lp-test-block--results {
    order: 3;
  }
</style>
