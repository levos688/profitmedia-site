---
import Layout from '../../layouts/Layout.astro';
import '../../styles/preview.css';
import AdsLpHeader from '../../components/ads/AdsLpHeader.astro';
import DealsHero from '../../components/deals/DealsHero.astro';
import DealsProofStrip from '../../components/deals/DealsProofStrip.astro';
import DealsContrast from '../../components/deals/DealsContrast.astro';
import DealsResults from '../../components/deals/DealsResults.astro';
import DealsGuard from '../../components/deals/DealsGuard.astro';
import DealsProcess from '../../components/deals/DealsProcess.astro';
import DealsComparison from '../../components/deals/DealsComparison.astro';
import DealsAudience from '../../components/deals/DealsAudience.astro';
import Clients from '../../components/Clients.astro';
import DealsContactForm from '../../components/deals/DealsContactForm.astro';
import PreviewFaq from '../../components/preview/PreviewFaq.astro';
import LeadCaptureModal from '../../components/preview/LeadCaptureModal.astro';
import DealsStickyCta from '../../components/deals/DealsStickyCta.astro';
import Footer from '../../components/Footer.astro';
import { dealsSeo, dealsPixelId, dealsFaqs } from '../../data/deals';
---

<Layout
  title={dealsSeo.title}
  description={dealsSeo.description}
  canonical={dealsSeo.canonical}
  noindex
  enableGtm={false}
  metaPixelId={dealsPixelId || undefined}
  preloadImage="/images/hero/photo-min.svg"
>
  <div
    class="preview-page"
    data-lead-page
    data-lead-source="deals-meta-lp"
    data-lead-source-prefix="deals"
    data-thank-you="/deals/thank-you"
  >
    <AdsLpHeader />
    <main id="main-content">
      <DealsHero />
      <DealsProofStrip />
      <DealsContrast />
      <DealsResults />
      <DealsGuard />
      <DealsProcess />
      <DealsComparison />
      <DealsAudience />
      <Clients />
      <DealsContactForm />
      <PreviewFaq items={dealsFaqs} />
    </main>
    <Footer minimal />
    <LeadCaptureModal />
    <DealsStickyCta />
  </div>
</Layout>
